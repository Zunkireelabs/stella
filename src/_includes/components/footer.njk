<footer class="bg-stella-text text-white">
  <div class="max-w-7xl mx-auto px-6 py-12 sm:py-16">

    <!-- Columns (collapsible accordions on mobile, static grid on sm+) -->
    <div class="divide-y divide-white/10 sm:divide-y-0 sm:grid sm:grid-cols-2 lg:grid-cols-4 sm:gap-8 lg:gap-12 mb-10 sm:mb-14">

      <!-- Brand block — always visible, no accordion toggle -->
      <div class="py-4 sm:py-0">
        <a href="/" class="font-pacifico text-2xl text-white">{{ site.name }}</a>
        <p class="mt-3 text-sm text-white/50 leading-relaxed">{{ site.tagline }}</p>
        <p class="mt-2 text-xs text-white/35 leading-relaxed">Autonomous agents that handle discovery, checkout, and operations — so your store never misses a sale.</p>
        <a href="/schedule-demo/"
           class="mt-5 inline-flex items-center gap-1.5 bg-white text-stella-text text-xs font-semibold rounded-full px-4 py-2 hover:opacity-90 transition-opacity">
          {{ site.cta.primary }} →
        </a>
      </div>

      <!-- Product -->
      <div x-data="{ open: false }" class="py-2 sm:py-0">
        <button @click="open = !open" class="w-full flex items-center justify-between py-2 sm:py-0 sm:pointer-events-none">
          <h3 class="text-xs font-semibold uppercase tracking-widest text-white/40 sm:mb-5">Product</h3>
          <svg class="sm:hidden w-4 h-4 text-white/40 transition-transform" :class="{ 'rotate-180': open }" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <ul x-show="open"
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 -translate-y-1"
            x-transition:enter-end="opacity-100 translate-y-0"
            class="sm:!block space-y-3 text-sm text-white/60 pt-3 sm:pt-0" style="display:none;">
          <li><a href="/storefront/" class="hover:text-white transition-colors">Storefront</a></li>
          <li><a href="/#hiw-section" class="hover:text-white transition-colors">How It Works</a></li>
          <li><a href="/#five-moments" class="hover:text-white transition-colors">Features</a></li>
          <li><a href="/customer-stories/" class="hover:text-white transition-colors">Customer Stories</a></li>
          <li><a href="/blog/" class="hover:text-white transition-colors">Blog</a></li>
        </ul>
      </div>

      <!-- Resources -->
      <div x-data="{ open: false }" class="py-2 sm:py-0">
        <button @click="open = !open" class="w-full flex items-center justify-between py-2 sm:py-0 sm:pointer-events-none">
          <h3 class="text-xs font-semibold uppercase tracking-widest text-white/40 sm:mb-5">Resources</h3>
          <svg class="sm:hidden w-4 h-4 text-white/40 transition-transform" :class="{ 'rotate-180': open }" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <ul x-show="open"
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 -translate-y-1"
            x-transition:enter-end="opacity-100 translate-y-0"
            class="sm:!block space-y-3 text-sm text-white/60 pt-3 sm:pt-0" style="display:none;">
          <li><a href="/blog/" class="hover:text-white transition-colors">Blog</a></li>
          <li><a href="/faq/" class="hover:text-white transition-colors">FAQs</a></li>
          <li><a href="https://docs.stella-commerce.com/" class="hover:text-white transition-colors">Developer Docs</a></li>
          <li><a href="/schedule-demo/" class="hover:text-white transition-colors">Schedule a Demo</a></li>
          <li><a href="/customer-stories/" class="hover:text-white transition-colors">Customer Stories</a></li>
        </ul>
      </div>

      <!-- Get Started -->
      <div x-data="{ open: false }" class="py-2 sm:py-0">
        <button @click="open = !open" class="w-full flex items-center justify-between py-2 sm:py-0 sm:pointer-events-none">
          <h3 class="text-xs font-semibold uppercase tracking-widest text-white/40 sm:mb-5">Get Started</h3>
          <svg class="sm:hidden w-4 h-4 text-white/40 transition-transform" :class="{ 'rotate-180': open }" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <ul x-show="open"
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 -translate-y-1"
            x-transition:enter-end="opacity-100 translate-y-0"
            class="sm:!block space-y-3 text-sm text-white/60 pt-3 sm:pt-0" style="display:none;">
          <li><a href="/schedule-demo/" class="hover:text-white transition-colors">Schedule a Demo</a></li>
          <li><a href="https://app.stella-commerce.com/login" class="hover:text-white transition-colors">Sign In</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Terms of Service</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 pt-8 text-center">
      <p class="text-sm text-white/40">© 2026 Stella · Agentic Commerce for Everyone</p>
    </div>

  </div>
</footer>
