{# ── What happens next: editorial split. Left = heading + short body. Right = stylized booking-timeline artifact. #}

{% set e = scheduleDemo.expect %}
{% set t = e.timeline %}

<section id="sd-expect" class="bg-white py-20 md:py-28 px-4 sm:px-6 md:px-10 lg:px-16">
  <div class="max-w-3xl mx-auto text-center">

    <!-- Heading + body, centered -->
    <p class="text-xs font-semibold tracking-[0.18em] uppercase text-stella-muted mb-4">
      {{ e.eyebrow }}
    </p>
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light text-stella-text tracking-[-0.015em] leading-[1.08]">
      {{ e.heading }}
    </h2>
    <p class="mt-5 text-body-lg text-stella-muted max-w-xl mx-auto">
      {{ e.body }}
    </p>

    <!-- Timeline artifact, centered below — green-shadow glow (matches storefront/pillars treatment) -->
    <div class="mt-12 md:mt-14 text-left">
      <div class="relative bg-white rounded-3xl border border-stella-border shadow-[0_30px_80px_-20px_rgba(134,239,172,0.55)] p-7 sm:p-10 overflow-hidden">

        <!-- Dot-grid backdrop — visible across the whole card -->
        <div class="absolute inset-0 pointer-events-none"
             style="background-image: radial-gradient(circle, rgba(22, 101, 52, 0.22) 1px, transparent 1.5px); background-size: 20px 20px;"></div>
        <!-- Very soft edge fade so the dots taper near the card border without wiping the centre -->
        <div class="absolute inset-0 pointer-events-none"
             style="background: radial-gradient(ellipse 90% 80% at 50% 50%, rgba(255,255,255,0) 55%, rgba(255,255,255,0.85) 100%);"></div>

        <!-- Caption row -->
        <div class="relative flex items-center gap-2 mb-8">
          <svg class="w-4 h-4 text-stella-forest" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8"  y1="2" x2="8"  y2="6"/>
            <line x1="3"  y1="10" x2="21" y2="10"/>
          </svg>
          <span class="text-xs font-semibold tracking-[0.14em] uppercase text-stella-muted">{{ t.caption }}</span>
        </div>

        <!-- Calendar strip: 3 days -->
        <div class="relative grid grid-cols-3 text-center">
          {% for d in t.days %}
          <div class="flex flex-col items-center">
            <span class="text-[11px] font-semibold tracking-[0.18em] uppercase text-stella-muted">{{ d.weekday }}</span>
            <span class="mt-1 text-4xl sm:text-5xl font-light text-stella-text tracking-[-0.02em] leading-none">{{ d.date }}</span>
          </div>
          {% endfor %}
        </div>

        <!-- Connector line + dots -->
        <div class="relative z-10 mt-7 mb-5">
          <!-- horizontal line behind dots, inset so it spans between the three centers (1/6 to 5/6) -->
          <div class="absolute left-[16.6%] right-[16.6%] top-1/2 h-px bg-stella-forest/30 -translate-y-1/2"></div>
          <div class="relative grid grid-cols-3">
            {% for d in t.days %}
            <div class="flex justify-center">
              <span class="w-3 h-3 rounded-full bg-stella-forest ring-4 ring-white"></span>
            </div>
            {% endfor %}
          </div>
        </div>

        <!-- Event labels -->
        <div class="relative grid grid-cols-3 text-center">
          {% for d in t.days %}
          <span class="text-sm text-stella-text">{{ d.label }}</span>
          {% endfor %}
        </div>

        <!-- Footnote -->
        <div class="relative mt-10 pt-5 border-t border-stella-border flex items-center justify-between gap-4">
          <span class="text-xs text-stella-muted">{{ t.footnote }}</span>
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-stella-forest">
            <span class="w-1.5 h-1.5 rounded-full bg-stella-forest"></span>
            Live walkthrough
          </span>
        </div>

      </div>
    </div>

  </div>
</section>
