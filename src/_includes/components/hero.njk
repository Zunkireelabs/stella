<section id="hero" class="relative flex items-center min-h-screen pt-20 pb-16 bg-stella-bg overflow-hidden">

  <!-- Subtle bg wash -->
  <div class="absolute inset-0 pointer-events-none">
    <div id="hero-blob-1" class="absolute top-[-60px] left-[-60px] w-[500px] h-[350px] rounded-full bg-stella-green blur-[120px] opacity-[0.06]"></div>
  </div>

  <!-- Left: text -->
  <div class="relative z-10 w-full md:w-1/2 px-8 md:pl-20 lg:pl-28 xl:pl-36 md:pr-4">

    <!-- Pills -->
    <div class="flex items-center flex-wrap gap-2 mb-6">
      <span class="text-xs text-stella-muted border border-stella-border rounded-full px-3 py-1">AI-powered</span>
      <span class="text-xs text-stella-muted border border-stella-border rounded-full px-3 py-1">Full buying journey</span>
      <span class="text-xs text-stella-muted border border-stella-border rounded-full px-3 py-1">24 / 7</span>
    </div>

    <h1 id="hero-headline" class="text-5xl sm:text-6xl lg:text-7xl font-bold text-stella-text tracking-[-0.03em] leading-[1.05]">
      Your store never<br>stops selling.
    </h1>

    <p id="hero-subhead" class="mt-5 text-body-lg text-stella-muted max-w-md">
      Not a chatbot — Stella's AI agents handle the full buying journey, from product discovery to checkout, right inside the conversation.
    </p>

    <div id="hero-ctas" class="mt-8 flex flex-col sm:flex-row gap-3">
      <a href="#" class="bg-stella-gradient text-stella-forest font-semibold rounded-xl px-8 py-3.5 text-sm hover:opacity-90 transition-opacity shadow-sm inline-flex items-center justify-center">
        Schedule Demo →
      </a>
      <a href="#" class="border border-stella-border text-stella-text font-medium rounded-xl px-8 py-3.5 text-sm hover:bg-stella-border/30 transition-colors inline-flex items-center justify-center">
        Contact Sales
      </a>
    </div>
    <p class="mt-4 text-xs text-stella-muted">15-minute demo — we'll show Stella selling live on your store.</p>
  </div>

  <!-- Right: Three.js canvas + floating ecommerce cards -->
  <div class="hidden md:flex md:w-1/2 items-center justify-center py-8">

    <!-- Canvas wrapper: positioning root for all 5 cards so they align with 3D line endpoints -->
    <div class="relative w-full max-w-[500px] aspect-square">
      <canvas id="stella-canvas" class="w-full h-full"></canvas>

      <!-- Positioning shell + inner .hero-float-card (GSAP animates only the inner div) -->

      <!-- Chat & Discover — inside top of globe -->
      <div class="absolute top-[9%] left-1/2 -translate-x-1/2 pointer-events-none select-none">
        <div class="hero-float-card flex items-center gap-2 bg-white border border-stella-border rounded-xl shadow-sm px-3 py-2" style="animation-delay:0s;animation-duration:3.8s">
          <div class="w-7 h-7 rounded-full bg-stella-gradient flex-shrink-0 flex items-center justify-center">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#166534" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
          </div>
          <div>
            <p class="text-xs font-medium text-stella-text leading-none">Chat & Discover</p>
            <p class="text-[10px] text-stella-muted mt-0.5 leading-none">Find anything instantly</p>
          </div>
        </div>
      </div>

      <!-- Products — inside right of globe -->
      <div class="absolute top-[28%] right-[6%] pointer-events-none select-none">
        <div class="hero-float-card flex items-center gap-2 bg-white border border-stella-border rounded-xl shadow-sm px-3 py-2" style="animation-delay:0.7s;animation-duration:4.5s">
          <div class="w-7 h-7 rounded-full bg-stella-lime/50 flex-shrink-0 flex items-center justify-center">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#166534" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
          </div>
          <div>
            <p class="text-xs font-medium text-stella-text leading-none">Products</p>
            <p class="text-[10px] text-stella-muted mt-0.5 leading-none">Rs&thinsp;2,500 &middot; In stock</p>
          </div>
        </div>
      </div>

      <!-- Order placed — inside lower-right of globe -->
      <div class="absolute top-[62%] right-[6%] pointer-events-none select-none">
        <div class="hero-float-card flex items-center gap-2 bg-white border border-stella-border rounded-xl shadow-sm px-3 py-2" style="border-left-width:3px;border-left-color:#86EFAC;animation-delay:1.4s;animation-duration:5.1s">
          <span class="text-stella-forest font-bold text-sm leading-none">✓</span>
          <div>
            <p class="text-xs font-medium text-stella-text leading-none">Order placed</p>
            <p class="text-[10px] text-stella-muted mt-0.5 leading-none">Rs&thinsp;3,200 confirmed</p>
          </div>
        </div>
      </div>

      <!-- Always online — inside lower-left of globe -->
      <div class="absolute top-[62%] left-[6%] pointer-events-none select-none">
        <div class="hero-float-card flex items-center gap-2 bg-white border border-stella-border rounded-xl shadow-sm px-3 py-2" style="animation-delay:0.4s;animation-duration:4.2s">
          <div class="w-7 h-7 rounded-full bg-stella-yellow/50 flex-shrink-0 flex items-center justify-center">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#166534" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </div>
          <div>
            <p class="text-xs font-medium text-stella-text leading-none">Always online</p>
            <p class="text-[10px] text-stella-muted mt-0.5 leading-none">24 / 7 · Never misses</p>
          </div>
        </div>
      </div>

      <!-- All Channels — inside upper-left of globe -->
      <div class="absolute top-[28%] left-[6%] pointer-events-none select-none">
        <div class="hero-float-card flex items-center gap-2 bg-white border border-stella-border rounded-xl shadow-sm px-3 py-2" style="animation-delay:1.1s;animation-duration:5.6s">
          <div class="w-7 h-7 rounded-full bg-stella-green/30 flex-shrink-0 flex items-center justify-center">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#166534" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 010 20M12 2a15.3 15.3 0 000 20"/></svg>
          </div>
          <div>
            <p class="text-xs font-medium text-stella-text leading-none">All Channels</p>
            <p class="text-[10px] text-stella-muted mt-0.5 leading-none">Web · WhatsApp · More</p>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Mobile: centered headline only (canvas hidden) -->
  <div class="md:hidden absolute bottom-8 left-0 right-0 flex justify-center">
    <p class="text-xs text-stella-muted">Scroll to explore →</p>
  </div>

</section>
