<section id="cs-featured" class="relative px-4 sm:px-6 md:px-16 lg:px-28 pt-4 md:pt-6 pb-16 md:pb-20">
  <div class="max-w-6xl mx-auto">

    <p class="text-xs font-semibold tracking-[0.18em] uppercase text-stella-muted mb-4 text-center">
      {{ customerStories.featured.eyebrow }}
    </p>

    <div class="bg-white rounded-3xl border border-stella-border shadow-[0_30px_80px_-20px_rgba(134,239,172,0.45)] overflow-hidden">

      <div class="grid md:grid-cols-5 gap-0">

        {# Left: image only, quote appears on hover #}
        <div class="md:col-span-3 group relative bg-stella-bg overflow-hidden min-h-[420px] md:min-h-[520px]">
          <img src="{{ customerStories.featured.image }}"
               alt="{{ customerStories.featured.imageAlt }}"
               loading="lazy"
               class="absolute inset-0 w-full h-full object-cover" />

          {# Small brand pill — always visible, top-left #}
          <div class="absolute top-4 left-4 flex items-center gap-2 bg-white/90 backdrop-blur-sm pl-1.5 pr-3 py-1.5 rounded-full shadow-sm">
            <div class="w-7 h-7 rounded-full bg-stella-forest text-white flex items-center justify-center text-[10px] font-semibold tracking-wide">
              {{ customerStories.featured.logoInitials }}
            </div>
            <div class="text-[11px] font-semibold text-stella-text leading-tight pr-0.5">{{ customerStories.featured.customer }}</div>
          </div>

          {# Hover: bottom gradient + quote sliding up #}
          <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-stella-text/85 via-stella-text/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 ease-out"></div>
          <div class="absolute inset-x-0 bottom-0 p-8 sm:p-10 opacity-0 translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-500 ease-out">
            <figure class="border-l-2 border-stella-lime pl-5 max-w-xl">
              <blockquote class="text-white text-lg sm:text-xl font-sans font-light leading-[1.45] tracking-[-0.01em]">
                &ldquo;{{ customerStories.featured.quote }}&rdquo;
              </blockquote>
              <figcaption class="mt-3 text-sm text-white/85">
                <span class="font-semibold text-white">{{ customerStories.featured.quoteAuthor }}</span> · {{ customerStories.featured.quoteRole }}
              </figcaption>
            </figure>
            <a href="{{ customerStories.featured.cta.href }}" class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-stella-lime hover:gap-2.5 transition-all">
              {{ customerStories.featured.cta.label }} <span>→</span>
            </a>
          </div>
        </div>

        {# Right: metrics panel #}
        <div class="md:col-span-2 bg-stella-bg/70 border-t md:border-t-0 md:border-l border-stella-border p-8 sm:p-12 md:p-14 flex flex-col justify-center gap-8">
          {% for m in customerStories.featured.metrics %}
            <div>
              <div class="text-4xl sm:text-5xl font-sans font-semibold text-stella-forest tracking-[-0.02em] leading-none">
                {{ m.value }}
              </div>
              <div class="mt-2 text-sm text-stella-muted leading-snug">
                {{ m.label }}
              </div>
            </div>
            {% if not loop.last %}
              <hr class="border-stella-border" />
            {% endif %}
          {% endfor %}
        </div>

      </div>
    </div>
  </div>
</section>
