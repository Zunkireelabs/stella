<section class="pt-10 pb-12 section-reveal bg-white">
  <div class="max-w-6xl mx-auto px-6">

    <!-- Heading -->
    <div class="text-center mb-10">
      <p class="text-xs tracking-widest uppercase text-stella-forest font-medium mb-4">Stella Dashboard</p>
      <h2 data-reveal="headline" class="mt-4 text-h2 font-light text-stella-text">Your store, always performing.</h2>
      <p data-reveal="subhead" class="mt-3 text-body text-stella-muted max-w-xl mx-auto">Every sale, every conversation, every order — tracked and run by Stella while you focus on growing.</p>
    </div>

    <!-- Bento Grid -->
    <div id="bento-grid" class="grid grid-cols-1 lg:grid-cols-3 gap-5">

      <!-- ── Cell A: Stella Dashboard (col-span-2) ── -->
      <div class="bento-cell lg:col-span-2 bg-stella-bg rounded-2xl border border-stella-border transition-all duration-200 hover:-translate-y-1 hover:shadow-lg hover:border-stella-green/40 overflow-hidden overflow-x-auto flex">

        <!-- Sidebar -->
        <div class="hidden lg:flex flex-col w-36 shrink-0 bg-stella-bg py-4">

          <!-- Logo -->
          <div class="flex items-center gap-2 px-4 mb-5">
            <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M6 0L7.4 4.6L12 6L7.4 7.4L6 12L4.6 7.4L0 6L4.6 4.6L6 0Z" fill="#166534"/>
            </svg>
            <span class="text-stella-forest font-bold text-sm tracking-tight">Stella</span>
          </div>

          <!-- Nav -->
          <nav class="flex-1 space-y-0.5 px-2">
            {% for item in dashboard.nav %}
            <div class="flex items-center gap-2 px-3 py-2 rounded-xl cursor-default transition-colors {{ 'bg-stella-forest/10 text-stella-forest' if item.active else 'text-stella-muted' }}">
              {% if item.icon == "grid" %}
                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor">
                  <path fill-rule="evenodd" d="M1 1h6v6H1V1zm0 8h6v6H1V9zm8-8h6v6H9V1zm0 8h6v6H9V9z"/>
                </svg>
              {% elif item.icon == "chat" %}
                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M0 2a2 2 0 012-2h12a2 2 0 012 2v8a2 2 0 01-2 2H4.414L0 15V2z"/>
                </svg>
              {% elif item.icon == "bag" %}
                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M8 1a2.5 2.5 0 00-2.5 2.5H3l-1 11h12l-1-11h-2.5A2.5 2.5 0 008 1zm0 1.5a1 1 0 011 1H7a1 1 0 011-1z"/>
                </svg>
              {% elif item.icon == "people" %}
                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M7 8a3 3 0 100-6 3 3 0 000 6zm-5 6s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H2zm10-6a2 2 0 100-4 2 2 0 000 4zm1 6h-1.5s.5-1 .5-2.5c.7.3 1 .8 1 1.5s-.5 1-.5 1H13z"/>
                </svg>
              {% elif item.icon == "box" %}
                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M8 0L0 4v8l8 4 8-4V4L8 0zm0 1.9l6 3-6 3-6-3 6-3zM1 5.4l6.5 3.25v5.95L1 11.35V5.4zm8.5 9.2V8.65L15 5.4v5.95L9.5 14.6z"/>
                </svg>
              {% elif item.icon == "chart" %}
                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M0 14h16v1.5H0V14zm1-2h2V8H1v4zm4 0h2V4H5v8zm4 0h2V6H9v6zm4 0h2V2h-2v10z"/>
                </svg>
              {% elif item.icon == "settings" %}
                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M8 4.754a3.246 3.246 0 100 6.492 3.246 3.246 0 000-6.492zM5.754 8a2.246 2.246 0 114.492 0 2.246 2.246 0 01-4.492 0z"/>
                  <path d="M9.796 1.343c-.527-1.79-3.065-1.79-3.592 0l-.094.319a.873.873 0 01-1.255.52l-.292-.16c-1.64-.892-3.433.902-2.54 2.541l.159.292a.873.873 0 01-.52 1.255l-.319.094c-1.79.527-1.79 3.065 0 3.592l.319.094a.873.873 0 01.52 1.255l-.16.292c-.892 1.64.901 3.434 2.541 2.54l.292-.159a.873.873 0 011.255.52l.094.319c.527 1.79 3.065 1.79 3.592 0l.094-.319a.873.873 0 011.255-.52l.292.16c1.64.893 3.434-.902 2.54-2.541l-.159-.292a.873.873 0 01.52-1.255l.319-.094c1.79-.527 1.79-3.065 0-3.592l-.319-.094a.873.873 0 01-.52-1.255l.16-.292c.893-1.64-.902-3.433-2.541-2.54l-.292.159a.873.873 0 01-1.255-.52l-.094-.319zm-2.633.283c.246-.835 1.428-.835 1.674 0l.094.319a1.873 1.873 0 002.693 1.115l.291-.16c.764-.415 1.6.42 1.184 1.185l-.159.292a1.873 1.873 0 001.116 2.692l.318.094c.835.246.835 1.428 0 1.674l-.319.094a1.873 1.873 0 00-1.115 2.693l.16.291c.415.764-.42 1.6-1.185 1.184l-.291-.159a1.873 1.873 0 00-2.693 1.116l-.094.318c-.246.835-1.428.835-1.674 0l-.094-.319a1.873 1.873 0 00-2.692-1.115l-.292.16c-.764.415-1.6-.42-1.184-1.185l.159-.291A1.873 1.873 0 003.06 9.74l-.319-.094c-.835-.246-.835-1.428 0-1.674l.319-.094A1.873 1.873 0 004.175 5.28l-.159-.292c-.415-.764.42-1.6 1.185-1.184l.292.159a1.873 1.873 0 002.692-1.115l.094-.319z"/>
                </svg>
              {% endif %}
              <span class="text-xs font-medium">{{ item.label }}</span>
            </div>
            {% endfor %}
          </nav>

          <!-- Store identity -->
          <div class="px-3 pt-3 mt-2 border-t border-stella-border">
            <div class="flex items-center gap-2">
              <div class="w-7 h-7 rounded-lg bg-stella-gradient flex items-center justify-center shrink-0">
                <span class="text-stella-forest text-[10px] font-bold">{{ dashboard.admin.initials }}</span>
              </div>
              <div class="min-w-0">
                <p class="text-xs font-semibold text-stella-text truncate">{{ dashboard.admin.name }}</p>
                <p class="text-[10px] text-stella-muted truncate">{{ dashboard.admin.role }}</p>
              </div>
            </div>
          </div>

        </div>

        <!-- Main content -->
        <div class="flex-1 flex flex-col min-w-0 bg-white overflow-hidden m-2 rounded-xl border border-stella-border shadow-sm">

          <!-- Header -->
          <div class="px-4 py-2 bg-stella-bg flex items-center justify-between shrink-0 border-b border-stella-border">
            <span class="text-[11px] font-bold text-stella-forest truncate">How's the shop today, <span class="text-stella-emerald">{{ dashboard.admin.name }}</span>?</span>
            <div class="flex items-center gap-2 shrink-0">
              <span class="text-[9px] text-stella-muted hidden sm:block border border-stella-border rounded px-1.5 py-0.5">May 2 – Jun 1</span>
              <div class="w-5 h-5 rounded bg-stella-forest flex items-center justify-center">
                <span class="text-[8px] font-bold text-stella-green">{{ dashboard.admin.initials }}</span>
              </div>
            </div>
          </div>

          <!-- 4 KPI tiles -->
          <div class="flex divide-x divide-stella-border border-b border-stella-border shrink-0">
            <div class="flex-1 p-2 lg:p-2.5">
              <p class="text-[8px] lg:text-[9px] font-medium text-stella-muted uppercase tracking-wide">Total customers</p>
              <p class="mt-0.5 text-sm lg:text-base font-bold text-stella-text" data-count data-target="1240" data-suffix="">0</p>
              <p class="mt-0.5 text-[8px] text-green-600">↑ 10.5% vs last period</p>
            </div>
            <div class="flex-1 p-2 lg:p-2.5">
              <p class="text-[8px] lg:text-[9px] font-medium text-stella-muted uppercase tracking-wide">Total orders</p>
              <p class="mt-0.5 text-sm lg:text-base font-bold text-stella-text" data-count data-target="342" data-suffix="">0</p>
              <p class="mt-0.5 text-[8px] text-red-500">↓ 4.2% vs last period</p>
            </div>
            <div class="flex-1 p-2 lg:p-2.5">
              <p class="text-[8px] lg:text-[9px] font-medium text-stella-muted uppercase tracking-wide">Avg order value</p>
              <p class="mt-0.5 text-sm lg:text-base font-bold text-stella-text" data-count data-target="2850" data-prefix="Rs " data-suffix="">Rs 0</p>
              <p class="mt-0.5 text-[8px] text-green-600">↑ 6.7% vs last period</p>
            </div>
            <div class="flex-1 p-2 lg:p-2.5">
              <p class="text-[8px] lg:text-[9px] font-medium text-stella-muted uppercase tracking-wide">Total products</p>
              <p class="mt-0.5 text-sm lg:text-base font-bold text-stella-text" data-count data-target="248" data-suffix="">0</p>
              <p class="mt-0.5 text-[8px] text-green-600">↑ 1.3% vs last period</p>
            </div>
          </div>

          <!-- Sales Revenue (left 60%) + Customer Channels donut (right 40%) -->
          <div class="flex divide-x divide-stella-border border-b border-stella-border shrink-0">

            <!-- Sales Revenue line chart -->
            <div class="p-3" style="flex:3">
              <div class="flex items-center justify-between mb-1.5">
                <p class="text-[9px] font-semibold text-stella-text">Sales Revenue</p>
                <span class="text-[8px] text-stella-muted border border-stella-border rounded px-1.5 py-0.5">Canvas</span>
              </div>
              <svg viewBox="0 0 200 52" class="w-full h-11" preserveAspectRatio="none">
                <defs>
                  <linearGradient id="rev-fill" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#86EFAC" stop-opacity="0.4"/>
                    <stop offset="100%" stop-color="#86EFAC" stop-opacity="0.02"/>
                  </linearGradient>
                </defs>
                <line x1="0" y1="10" x2="200" y2="10" stroke="#e5e7eb" stroke-width="0.5"/>
                <line x1="0" y1="26" x2="200" y2="26" stroke="#e5e7eb" stroke-width="0.5"/>
                <line x1="0" y1="42" x2="200" y2="42" stroke="#e5e7eb" stroke-width="0.5"/>
                <path d="M0,40 C10,38 15,43 25,35 S40,31 50,27 S65,33 75,23 S90,27 100,19 S115,23 125,15 S140,21 150,11 S165,17 175,9 S190,14 200,7 L200,52 L0,52 Z" fill="url(#rev-fill)"/>
                <path d="M0,40 C10,38 15,43 25,35 S40,31 50,27 S65,33 75,23 S90,27 100,19 S115,23 125,15 S140,21 150,11 S165,17 175,9 S190,14 200,7" fill="none" stroke="#16a34a" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"/>
                <circle cx="200" cy="7" r="2.5" fill="#16a34a"/>
              </svg>
              <div class="flex justify-between mt-1">
                <span class="text-[7px] text-stella-muted">May 2</span>
                <span class="text-[7px] text-stella-muted">May 15</span>
                <span class="text-[7px] text-stella-muted">Jun 1</span>
              </div>
            </div>

            <!-- Customer Channels donut -->
            <div class="p-3" style="flex:2">
              <p class="text-[9px] font-semibold text-stella-text mb-2">Customer Channels</p>
              <div class="flex items-center gap-2.5">
                <svg width="52" height="52" viewBox="0 0 52 52" class="shrink-0">
                  <circle cx="26" cy="26" r="18" fill="none" stroke="#166534" stroke-width="9" stroke-dasharray="50.9 113.1" stroke-dashoffset="0" transform="rotate(-90 26 26)"/>
                  <circle cx="26" cy="26" r="18" fill="none" stroke="#C13584" stroke-width="9" stroke-dasharray="31.7 113.1" stroke-dashoffset="-50.9" transform="rotate(-90 26 26)"/>
                  <circle cx="26" cy="26" r="18" fill="none" stroke="#25D366" stroke-width="9" stroke-dasharray="20.4 113.1" stroke-dashoffset="-82.6" transform="rotate(-90 26 26)"/>
                  <circle cx="26" cy="26" r="18" fill="none" stroke="#0084FF" stroke-width="9" stroke-dasharray="9.0 113.1" stroke-dashoffset="-103.0" transform="rotate(-90 26 26)"/>
                  <circle cx="26" cy="26" r="18" fill="none" stroke="#9CA3AF" stroke-width="9" stroke-dasharray="1.1 113.1" stroke-dashoffset="-112.0" transform="rotate(-90 26 26)"/>
                  <circle cx="26" cy="26" r="11" fill="white"/>
                </svg>
                <div class="space-y-0.5 flex-1 min-w-0">
                  <div class="flex items-center justify-between"><span class="flex items-center gap-1 text-[8px] text-stella-muted"><span class="w-1.5 h-1.5 rounded-full shrink-0" style="background:#166534"></span>Web</span><span class="text-[8px] font-semibold text-stella-text">45%</span></div>
                  <div class="flex items-center justify-between"><span class="flex items-center gap-1 text-[8px] text-stella-muted"><span class="w-1.5 h-1.5 rounded-full shrink-0" style="background:#C13584"></span>Instagram</span><span class="text-[8px] font-semibold text-stella-text">28%</span></div>
                  <div class="flex items-center justify-between"><span class="flex items-center gap-1 text-[8px] text-stella-muted"><span class="w-1.5 h-1.5 rounded-full shrink-0" style="background:#25D366"></span>Whatsapp</span><span class="text-[8px] font-semibold text-stella-text">18%</span></div>
                  <div class="flex items-center justify-between"><span class="flex items-center gap-1 text-[8px] text-stella-muted"><span class="w-1.5 h-1.5 rounded-full shrink-0" style="background:#0084FF"></span>Messenger</span><span class="text-[8px] font-semibold text-stella-text">8%</span></div>
                  <div class="flex items-center justify-between"><span class="flex items-center gap-1 text-[8px] text-stella-muted"><span class="w-1.5 h-1.5 rounded-full shrink-0" style="background:#9CA3AF"></span>Manual</span><span class="text-[8px] font-semibold text-stella-text">1%</span></div>
                </div>
              </div>
            </div>

          </div>

          <!-- Recent Orders (left 60%) + Inventory Health (right 40%) -->
          <div class="flex divide-x divide-stella-border flex-1 min-h-0">

            <!-- Recent Orders -->
            <div class="p-3 overflow-hidden" style="flex:3">
              <div class="flex items-center justify-between mb-2">
                <p class="text-[9px] font-semibold text-stella-text">Recent Orders</p>
                <span class="text-[8px] text-stella-forest font-medium cursor-default">View All →</span>
              </div>
              <table class="w-full">
                <thead>
                  <tr class="border-b border-stella-border">
                    <th class="text-left text-[8px] font-medium text-stella-muted pb-1 pr-2">ORDER</th>
                    <th class="text-left text-[8px] font-medium text-stella-muted pb-1 pr-2">CUSTOMER</th>
                    <th class="text-left text-[8px] font-medium text-stella-muted pb-1">STATUS</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="border-b border-stella-border/40">
                    <td class="py-1.5 text-[8px] text-stella-muted pr-2">#1042</td>
                    <td class="py-1.5 text-[8px] text-stella-text pr-2">Priya Sharma</td>
                    <td class="py-1.5"><span class="text-[7px] font-semibold text-green-700 bg-green-100 px-1.5 py-0.5 rounded-full">Delivered</span></td>
                  </tr>
                  <tr class="border-b border-stella-border/40">
                    <td class="py-1.5 text-[8px] text-stella-muted pr-2">#1041</td>
                    <td class="py-1.5 text-[8px] text-stella-text pr-2">Rohan KC</td>
                    <td class="py-1.5"><span class="text-[7px] font-semibold text-amber-700 bg-amber-100 px-1.5 py-0.5 rounded-full">Shipped</span></td>
                  </tr>
                  <tr>
                    <td class="py-1.5 text-[8px] text-stella-muted pr-2">#1040</td>
                    <td class="py-1.5 text-[8px] text-stella-text pr-2">Sita Rai</td>
                    <td class="py-1.5"><span class="text-[7px] font-semibold text-blue-700 bg-blue-100 px-1.5 py-0.5 rounded-full">Processing</span></td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- Inventory Health -->
            <div class="p-3 flex flex-col justify-between" style="flex:2">
              <p class="text-[9px] font-semibold text-stella-text">Inventory Health</p>
              <div>
                <div class="flex items-center gap-1.5 mb-1">
                  <span class="w-2 h-2 rounded-full bg-red-500 shrink-0 animate-pulse"></span>
                  <span class="text-[9px] font-bold text-red-600">83 out of stock</span>
                </div>
                <p class="text-[8px] text-stella-muted mb-2">Across 12 product variants</p>
                <span class="text-[8px] font-semibold text-stella-forest border border-stella-green/40 rounded px-2 py-1 cursor-default">Manage Inventory →</span>
              </div>
            </div>

          </div>
        </div>

      </div>

      <!-- ── Cell B: Customer Account (col-span-1) ── -->
      <div class="bento-cell lg:col-span-1 bg-white rounded-2xl border border-stella-border shadow-stella transition-all duration-200 hover:-translate-y-1 hover:shadow-stella-lg hover:border-stella-green/40 p-8 flex flex-col">
        <h3 class="text-base font-semibold text-stella-text mb-4">Your customers, on your store.</h3>

        <div class="bg-gray-50 rounded-xl border border-stella-border overflow-hidden flex-1 shadow-md">
          <div class="px-4 py-3 border-b border-stella-border flex items-center gap-3">
            <img src="https://i.pravatar.cc/64?img=47" class="w-8 h-8 rounded-full object-cover shrink-0" alt="Priya Sharma">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-1.5 flex-wrap">
                <p class="text-sm font-semibold text-stella-text">Priya Sharma</p>
                <span class="inline-flex items-center gap-1 bg-stella-green/25 text-stella-forest text-[10px] font-semibold px-1.5 py-0.5 rounded-full">
                  <span class="w-1.5 h-1.5 rounded-full bg-stella-emerald"></span>Active
                </span>
              </div>
              <p class="text-xs text-stella-muted">priya@email.com</p>
            </div>
          </div>
          <div class="p-3">
            <p class="text-xs font-semibold text-stella-muted uppercase tracking-wider mb-2.5">Recent Orders</p>
            <div class="grid grid-cols-2 gap-2">
              <div class="bg-white rounded-xl border border-stella-border overflow-hidden">
                <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=400&h=280&fit=crop&q=80" class="w-full h-20 object-cover" alt="Air Runner Pro">
                <div class="p-2">
                  <p class="text-xs font-medium text-stella-text leading-tight">Air Runner Pro</p>
                  <p class="text-xs font-semibold text-stella-forest mt-0.5">₨ 3,200</p>
                  <span class="inline-flex items-center gap-1 text-[10px] font-semibold text-green-700 bg-green-100 px-1.5 py-0.5 rounded-full mt-1">
                    <span class="w-1 h-1 rounded-full bg-green-500"></span>Delivered
                  </span>
                </div>
              </div>
              <div class="bg-white rounded-xl border border-stella-border overflow-hidden">
                <img src="https://images.unsplash.com/photo-1489987707025-afc232f7ea0f?w=400&h=280&fit=crop&q=80" class="w-full h-20 object-cover" alt="Cotton Formal Shirt">
                <div class="p-2">
                  <p class="text-xs font-medium text-stella-text leading-tight">Cotton Formal Shirt</p>
                  <p class="text-xs font-semibold text-stella-forest mt-0.5">₨ 1,800</p>
                  <span class="inline-flex items-center gap-1 text-[10px] font-semibold text-amber-700 bg-amber-100 px-1.5 py-0.5 rounded-full mt-1">
                    <span class="w-1 h-1 rounded-full bg-amber-500"></span>Shipped
                  </span>
                </div>
              </div>
            </div>
            <div class="mt-3 pt-3 border-t border-stella-border flex items-center gap-1.5">
              <span class="text-sm">📍</span>
              <span class="text-xs text-stella-muted">Thamel, Kathmandu</span>
            </div>
          </div>
        </div>
      </div>

      <!-- ── Cell C: Audit Log (col-span-1) ── -->
      <div class="bento-cell lg:col-span-1 bg-white rounded-2xl border border-stella-border shadow-stella transition-all duration-200 hover:-translate-y-1 hover:shadow-stella-lg hover:border-stella-green/40 p-8 flex flex-col">
        <h3 class="text-base font-semibold text-stella-text mb-4 min-h-[2.5rem]">Every action, accounted for.</h3>

        <div class="bg-gray-50 rounded-xl border border-stella-border p-3 shadow-md">
          <div class="flex items-center gap-2.5 py-2 border-b border-stella-border">
            <span class="text-sm shrink-0">🔍</span>
            <p class="text-xs text-stella-text flex-1 truncate">Searched "blue sneakers size 42"</p>
            <span class="text-xs text-stella-muted shrink-0">2m ago</span>
          </div>
          <div class="flex items-center gap-2.5 py-2 border-b border-stella-border">
            <span class="text-sm shrink-0">🛒</span>
            <p class="text-xs text-stella-text flex-1 truncate">Added item to cart (₨ 3,500)</p>
            <span class="text-xs text-stella-muted shrink-0">2m ago</span>
          </div>
          <div class="flex items-center gap-2.5 py-2 border-b border-stella-border">
            <span class="text-sm shrink-0">📋</span>
            <p class="text-xs text-stella-text flex-1 truncate">Viewed order history</p>
            <span class="text-xs text-stella-muted shrink-0">5m ago</span>
          </div>
          <div class="flex items-center gap-2.5 py-2 border-b border-stella-border">
            <span class="text-sm shrink-0">🔍</span>
            <p class="text-xs text-stella-text flex-1 truncate">Searched "running shoes"</p>
            <span class="text-xs text-stella-muted shrink-0">9m ago</span>
          </div>
          <div class="flex items-center justify-between pt-3">
            <div>
              <p class="text-xs text-stella-muted">Budget: ₨ 10,000 · Used: ₨ 3,500</p>
              <p class="text-xs text-stella-muted mt-0.5">Agent: Stella · Approved by customer</p>
            </div>
            <button class="text-xs font-semibold text-stella-forest border border-stella-green/40 rounded-lg px-3 py-1.5 hover:bg-stella-green/10 transition-colors shrink-0">Revoke →</button>
          </div>
