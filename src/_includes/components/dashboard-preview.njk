<section class="pt-10 pb-12 section-reveal bg-white">
  <div class="max-w-6xl mx-auto px-6">

    <!-- Heading -->
    <div class="text-center mb-10">
      <p class="text-xs tracking-widest uppercase text-stella-forest font-medium mb-4">Stella Dashboard</p>
      <h2 data-reveal="headline" class="mt-4 text-h2 font-light text-stella-text">Your store, always performing.</h2>
      <p data-reveal="subhead" class="mt-3 text-body text-stella-muted max-w-xl mx-auto">Every sale, every conversation, every order — tracked and run by Stella while you focus on growing.</p>
    </div>

    <!-- Bento Grid -->
    <div id="bento-grid" class="grid grid-cols-1 lg:grid-cols-3 gap-5">

      <!-- ── Cell A: Stella Dashboard (col-span-2) ── -->
      <div class="bento-cell lg:col-span-2 bg-stella-bg rounded-2xl border border-stella-border transition-all duration-200 hover:-translate-y-1 hover:shadow-lg hover:border-stella-green/40 overflow-hidden overflow-x-auto flex">

        <!-- Sidebar -->
        <div class="hidden lg:flex flex-col w-36 shrink-0 bg-stella-bg py-4 border-r border-stella-border">

          <!-- Logo -->
          <div class="flex items-center gap-2 px-4 mb-5">
            <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M6 0L7.4 4.6L12 6L7.4 7.4L6 12L4.6 7.4L0 6L4.6 4.6L6 0Z" fill="#166534"/>
            </svg>
            <span class="text-stella-forest font-bold text-sm tracking-tight">Stella</span>
          </div>

          <!-- Nav -->
          <nav class="flex-1 space-y-0.5 px-2">
            {% for item in dashboard.nav %}
            <div class="flex items-center gap-2 px-3 py-2 rounded-xl cursor-default transition-colors {{ 'bg-stella-forest/10 text-stella-forest' if item.active else 'text-stella-muted' }}">
              {% if item.icon == "grid" %}
                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor">
                  <path fill-rule="evenodd" d="M1 1h6v6H1V1zm0 8h6v6H1V9zm8-8h6v6H9V1zm0 8h6v6H9V9z"/>
                </svg>
              {% elif item.icon == "chat" %}
                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M0 2a2 2 0 012-2h12a2 2 0 012 2v8a2 2 0 01-2 2H4.414L0 15V2z"/>
                </svg>
              {% elif item.icon == "bag" %}
                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M8 1a2.5 2.5 0 00-2.5 2.5H3l-1 11h12l-1-11h-2.5A2.5 2.5 0 008 1zm0 1.5a1 1 0 011 1H7a1 1 0 011-1z"/>
                </svg>
              {% elif item.icon == "people" %}
                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M7 8a3 3 0 100-6 3 3 0 000 6zm-5 6s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H2zm10-6a2 2 0 100-4 2 2 0 000 4zm1 6h-1.5s.5-1 .5-2.5c.7.3 1 .8 1 1.5s-.5 1-.5 1H13z"/>
                </svg>
              {% elif item.icon == "box" %}
                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M8 0L0 4v8l8 4 8-4V4L8 0zm0 1.9l6 3-6 3-6-3 6-3zM1 5.4l6.5 3.25v5.95L1 11.35V5.4zm8.5 9.2V8.65L15 5.4v5.95L9.5 14.6z"/>
                </svg>
              {% endif %}
              <span class="text-xs font-medium">{{ item.label }}</span>
            </div>
            {% endfor %}
          </nav>

          <!-- Store identity -->
          <div class="px-3 pt-3 mt-2 border-t border-stella-border">
            <div class="flex items-center gap-2">
              <div class="w-7 h-7 rounded-lg bg-stella-gradient flex items-center justify-center shrink-0">
                <span class="text-stella-forest text-[10px] font-bold">{{ dashboard.admin.initials }}</span>
              </div>
              <div class="min-w-0">
                <p class="text-xs font-semibold text-stella-text truncate">{{ dashboard.admin.name }}</p>
                <p class="text-[10px] text-stella-muted truncate">{{ dashboard.admin.role }}</p>
              </div>
            </div>
          </div>

        </div>

        <!-- Main content -->
        <div class="flex-1 flex flex-col min-w-0 bg-white">

          <!-- Gradient header bar -->
          <div class="px-4 py-2.5 bg-stella-bg flex items-center justify-between shrink-0 border-b border-stella-border">
            <span class="text-xs font-bold text-stella-forest">Overview</span>
            <div class="flex items-center gap-3">
              <div class="flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-stella-forest animate-pulse"></span>
                <span class="text-[10px] font-semibold text-stella-forest">Live</span>
              </div>
              <div class="flex items-center gap-1.5">
                <div class="w-6 h-6 rounded-lg bg-stella-forest flex items-center justify-center shrink-0">
                  <span class="text-[9px] font-bold text-stella-green">{{ dashboard.admin.initials }}</span>
                </div>
                <div class="leading-tight">
                  <p class="text-[10px] font-semibold text-stella-forest leading-none">{{ dashboard.admin.name }}</p>
                  <p class="text-[9px] text-stella-forest/60 leading-none mt-0.5">{{ dashboard.admin.role }}</p>
                </div>
              </div>
            </div>
          </div>

          <!-- KPI row -->
          <div class="grid grid-cols-3 divide-x divide-stella-border border-b border-stella-border shrink-0">
            <div class="p-2 lg:p-3 border-t-2 border-t-stella-emerald">
              <p class="text-[9px] lg:text-[10px] font-medium text-stella-muted uppercase tracking-wide">Revenue Today</p>
              <p class="mt-1 text-base lg:text-lg font-bold text-stella-forest" data-count data-target="47200" data-prefix="₨ " data-suffix="">₨ 0</p>
              <p class="mt-0.5 text-[9px] lg:text-[10px] text-stella-muted">↑ 18% vs yesterday</p>
            </div>
            <div class="p-2 lg:p-3 border-t-2 border-t-stella-forest">
              <p class="text-[9px] lg:text-[10px] font-medium text-stella-muted uppercase tracking-wide">AI Convos</p>
              <p class="mt-1 text-base lg:text-lg font-bold text-stella-forest" data-count data-target="138" data-suffix="">0</p>
              <p class="mt-0.5 text-[9px] lg:text-[10px] text-stella-muted">Today</p>
            </div>
            <div class="p-2 lg:p-3 border-t-2" style="border-top-color:#D4F08A">
              <p class="text-[9px] lg:text-[10px] font-medium text-stella-muted uppercase tracking-wide">Conversion</p>
              <p class="mt-1 text-base lg:text-lg font-bold text-stella-forest" data-count data-target="34" data-suffix="%">0%</p>
              <p class="mt-0.5 text-[9px] lg:text-[10px] text-stella-muted">+12% this week</p>
            </div>
          </div>

          <!-- Channels + Revenue chart -->
          <div class="grid grid-cols-2 divide-x divide-stella-border flex-1">

            <!-- Channels -->
            <div class="p-4">
              <p class="text-[10px] font-semibold text-stella-muted uppercase tracking-wider mb-3">Channels</p>
              <div class="space-y-3">
                {% for ch in dashboard.channels %}
                <div>
                  <div class="flex items-center justify-between mb-1.5">
                    <span class="flex items-center gap-1.5 text-xs font-medium text-stella-text">
                      {% if ch.icon == "whatsapp" %}
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="#25D366"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                      {% elif ch.icon == "facebook" %}
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="#1877F2"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                      {% elif ch.icon == "instagram" %}
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none">
                          <defs><linearGradient id="ig-bar" x1="0%" y1="100%" x2="100%" y2="0%"><stop offset="0%" stop-color="#F77737"/><stop offset="50%" stop-color="#C13584"/><stop offset="100%" stop-color="#833AB4"/></linearGradient></defs>
                          <path fill="url(#ig-bar)" d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                        </svg>
                      {% endif %}
                      {{ ch.name }}
                    </span>
                    <span class="text-[10px] text-stella-muted">{{ ch.pct }}%</span>
                  </div>
                  <div class="h-1.5 bg-stella-border rounded-full overflow-hidden">
                    <div class="channel-bar h-1.5 rounded-full" data-width="{{ ch.pct }}%" style="width:0%; background-color:{{ ch.barColor }}"></div>
                  </div>
                </div>
                {% endfor %}
              </div>
            </div>

            <!-- Revenue chart -->
            <div class="p-4">
              <div class="flex items-center justify-between mb-2">
                <p class="text-[10px] font-semibold text-stella-muted uppercase tracking-wider">Revenue</p>
                <span class="text-[10px] text-stella-muted bg-stella-border/60 px-2 py-0.5 rounded-full">24h</span>
              </div>
              <svg viewBox="0 0 240 60" class="w-full h-14" preserveAspectRatio="none">
                <rect x="0"   y="57" width="7" height="3"  rx="1.5" fill="#86EFAC" fill-opacity="0.45"/>
                <rect x="10"  y="58" width="7" height="2"  rx="1.5" fill="#86EFAC" fill-opacity="0.45"/>
                <rect x="20"  y="58" width="7" height="2"  rx="1.5" fill="#86EFAC" fill-opacity="0.45"/>
                <rect x="30"  y="58" width="7" height="2"  rx="1.5" fill="#86EFAC" fill-opacity="0.45"/>
                <rect x="40"  y="57" width="7" height="3"  rx="1.5" fill="#86EFAC" fill-opacity="0.45"/>
                <rect x="50"  y="55" width="7" height="5"  rx="1.5" fill="#86EFAC" fill-opacity="0.55"/>
                <rect x="60"  y="51" width="7" height="9"  rx="1.5" fill="#86EFAC" fill-opacity="0.60"/>
                <rect x="70"  y="44" width="7" height="16" rx="1.5" fill="#86EFAC" fill-opacity="0.65"/>
                <rect x="80"  y="34" width="7" height="26" rx="1.5" fill="#86EFAC" fill-opacity="0.70"/>
                <rect x="90"  y="26" width="7" height="34" rx="1.5" fill="#86EFAC" fill-opacity="0.75"/>
                <rect x="100" y="19" width="7" height="41" rx="1.5" fill="#4ADE80" fill-opacity="0.70"/>
                <rect x="110" y="13" width="7" height="47" rx="1.5" fill="#4ADE80" fill-opacity="0.75"/>
                <rect x="120" y="8"  width="7" height="52" rx="1.5" fill="#4ADE80" fill-opacity="0.80"/>
                <rect x="130" y="15" width="7" height="45" rx="1.5" fill="#4ADE80" fill-opacity="0.80"/>
                <rect x="140" y="21" width="7" height="39" rx="1.5" fill="#4ADE80" fill-opacity="0.85"/>
                <rect x="150" y="17" width="7" height="43" rx="1.5" fill="#22C55E" fill-opacity="0.85"/>
                <rect x="160" y="11" width="7" height="49" rx="1.5" fill="#22C55E" fill-opacity="0.90"/>
                <rect x="170" y="7"  width="7" height="53" rx="1.5" fill="#10B981" fill-opacity="0.85"/>
                <rect x="180" y="3"  width="7" height="57" rx="1.5" fill="#10B981" fill-opacity="0.90"/>
                <rect x="190" y="1"  width="7" height="59" rx="1.5" fill="#10B981" fill-opacity="0.95"/>
                <rect x="200" y="8"  width="7" height="52" rx="1.5" fill="#10B981"/>
                <rect x="210" y="5"  width="7" height="55" rx="1.5" fill="#10B981"/>
                <rect x="220" y="3"  width="7" height="57" rx="1.5" fill="#10B981"/>
                <rect x="230" y="0"  width="7" height="60" rx="1.5" fill="#10B981"/>
              </svg>
              <div class="flex items-center justify-between mt-2">
                <div class="flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-stella-emerald animate-pulse"></span>
                  <span class="text-[10px] text-stella-muted">Live</span>
                </div>
                <span class="text-[10px] font-semibold text-stella-forest">₨ 47,200 today</span>
              </div>
            </div>

          </div>
        </div>

      </div>

      <!-- ── Cell B: Customer Account (col-span-1) ── -->
      <div class="bento-cell lg:col-span-1 bg-white rounded-2xl border border-stella-border shadow-stella transition-all duration-200 hover:-translate-y-1 hover:shadow-stella-lg hover:border-stella-green/40 p-8 flex flex-col">
        <h3 class="text-base font-semibold text-stella-text mb-4">Your customers, on your store.</h3>

        <div class="bg-gray-50 rounded-xl border border-stella-border overflow-hidden flex-1 shadow-md">
          <div class="px-4 py-3 border-b border-stella-border flex items-center gap-3">
            <img src="https://i.pravatar.cc/64?img=47" class="w-8 h-8 rounded-full object-cover shrink-0" alt="Priya Sharma">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-1.5 flex-wrap">
                <p class="text-sm font-semibold text-stella-text">Priya Sharma</p>
                <span class="inline-flex items-center gap-1 bg-stella-green/25 text-stella-forest text-[10px] font-semibold px-1.5 py-0.5 rounded-full">
                  <span class="w-1.5 h-1.5 rounded-full bg-stella-emerald"></span>Active
                </span>
              </div>
              <p class="text-xs text-stella-muted">priya@email.com</p>
            </div>
          </div>
          <div class="p-3">
            <p class="text-xs font-semibold text-stella-muted uppercase tracking-wider mb-2.5">Recent Orders</p>
            <div class="grid grid-cols-2 gap-2">
              <div class="bg-white rounded-xl border border-stella-border overflow-hidden">
                <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=400&h=280&fit=crop&q=80" class="w-full h-20 object-cover" alt="Air Runner Pro">
                <div class="p-2">
                  <p class="text-xs font-medium text-stella-text leading-tight">Air Runner Pro</p>
                  <p class="text-xs font-semibold text-stella-forest mt-0.5">₨ 3,200</p>
                  <span class="inline-flex items-center gap-1 text-[10px] font-semibold text-green-700 bg-green-100 px-1.5 py-0.5 rounded-full mt-1">
                    <span class="w-1 h-1 rounded-full bg-green-500"></span>Delivered
                  </span>
                </div>
              </div>
              <div class="bg-white rounded-xl border border-stella-border overflow-hidden">
                <img src="https://images.unsplash.com/photo-1489987707025-afc232f7ea0f?w=400&h=280&fit=crop&q=80" class="w-full h-20 object-cover" alt="Cotton Formal Shirt">
                <div class="p-2">
                  <p class="text-xs font-medium text-stella-text leading-tight">Cotton Formal Shirt</p>
                  <p class="text-xs font-semibold text-stella-forest mt-0.5">₨ 1,800</p>
                  <span class="inline-flex items-center gap-1 text-[10px] font-semibold text-amber-700 bg-amber-100 px-1.5 py-0.5 rounded-full mt-1">
                    <span class="w-1 h-1 rounded-full bg-amber-500"></span>Shipped
                  </span>
                </div>
              </div>
            </div>
            <div class="mt-3 pt-3 border-t border-stella-border flex items-center gap-1.5">
              <span class="text-sm">📍</span>
              <span class="text-xs text-stella-muted">Thamel, Kathmandu</span>
            </div>
          </div>
        </div>
      </div>

      <!-- ── Cell C: Audit Log (col-span-1) ── -->
      <div class="bento-cell lg:col-span-1 bg-white rounded-2xl border border-stella-border shadow-stella transition-all duration-200 hover:-translate-y-1 hover:shadow-stella-lg hover:border-stella-green/40 p-8 flex flex-col">
        <h3 class="text-base font-semibold text-stella-text mb-4 min-h-[2.5rem]">Every action, accounted for.</h3>

        <div class="bg-gray-50 rounded-xl border border-stella-border p-3 shadow-md">
          <div class="flex items-center gap-2.5 py-2 border-b border-stella-border">
            <span class="text-sm shrink-0">🔍</span>
            <p class="text-xs text-stella-text flex-1 truncate">Searched "blue sneakers size 42"</p>
            <span class="text-xs text-stella-muted shrink-0">2m ago</span>
          </div>
          <div class="flex items-center gap-2.5 py-2 border-b border-stella-border">
            <span class="text-sm shrink-0">🛒</span>
            <p class="text-xs text-stella-text flex-1 truncate">Added item to cart (₨ 3,500)</p>
            <span class="text-xs text-stella-muted shrink-0">2m ago</span>
          </div>
          <div class="flex items-center gap-2.5 py-2 border-b border-stella-border">
            <span class="text-sm shrink-0">📋</span>
            <p class="text-xs text-stella-text flex-1 truncate">Viewed order history</p>
            <span class="text-xs text-stella-muted shrink-0">5m ago</span>
          </div>
          <div class="flex items-center gap-2.5 py-2 border-b border-stella-border">
            <span class="text-sm shrink-0">🔍</span>
            <p class="text-xs text-stella-text flex-1 truncate">Searched "running shoes"</p>
            <span class="text-xs text-stella-muted shrink-0">9m ago</span>
          </div>
          <div class="flex items-center justify-between pt-3">
            <div>
              <p class="text-xs text-stella-muted">Budget: ₨ 10,000 · Used: ₨ 3,500</p>
              <p class="text-xs text-stella-muted mt-0.5">Agent: Stella · Approved by customer</p>
            </div>
            <button class="text-xs font-semibold text-stella-forest border border-stella-green/40 rounded-lg px-3 py-1.5 hover:bg-stella-green/10 transition-colors shrink-0">Revoke →</button>
          </div>
        </div>
      </div>

      <!-- ── Cell D: Catalog Sync (col-span-1) ── -->
      <div class="bento-cell lg:col-span-1 bg-white rounded-2xl border border-stella-border shadow-stella transition-all duration-200 hover:-translate-y-1 hover:shadow-stella-lg hover:border-stella-green/40 p-8 flex flex-col">
        <h3 class="text-base font-semibold text-stella-text mb-4 min-h-[2.5rem]">Your catalog, always current.</h3>

        <div class="bg-gray-50 rounded-xl border border-stella-border p-4 shadow-md">
          <div class="flex items-end gap-2 mb-4">
            <span class="text-4xl font-bold text-stella-forest" data-count data-target="248" data-suffix="">0</span>
            <div class="mb-1">
              <p class="text-sm font-medium text-stella-text">products synced</p>
              <div class="flex items-center gap-1.5 mt-0.5">
                <span class="w-1.5 h-1.5 rounded-full bg-stella-emerald animate-pulse"></span>
                <span class="text-xs text-stella-muted">Synced · 2m ago</span>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-3 gap-2 mb-4">
            <img src="https://images.unsplash.com/photo-1523381210434-271e8be1f52b?w=200&h=200&fit=crop&q=80" class="rounded-xl aspect-square object-cover w-full" alt="Clothing">
            <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=200&h=200&fit=crop&q=80" class="rounded-xl aspect-square object-cover w-full" alt="Shoes">
