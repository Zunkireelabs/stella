<script>
function stellaCart() {
  return {
    chatOpen: false,
    init() {
      const observer = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          setTimeout(() => { this.chatOpen = true; }, 1500);
          observer.disconnect();
        }
      }, { threshold: 0.3 });
      observer.observe(this.$el);
    }
  };
}
