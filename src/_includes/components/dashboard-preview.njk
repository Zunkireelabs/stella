<script>
function stellaCart() {
  return {
    chatOpen: false,
    inputText: '',
    // Shopper questions that type+erase on a loop inside the chat input
    questions: [
      'Will the Trail Runner X fit a size 41?',
      'Anything to go with these shoes?',
      'Do you have these in black?'
    ],
    init() {
      const observer = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          setTimeout(() => { this.openChat(); }, 1500);
          observer.disconnect();
        }
      }, { threshold: 0.3 });
      observer.observe(this.$el);
    },
    openChat() {
      this.chatOpen = true;
      // Reduced-motion: show one question statically, no looping animation
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        this.inputText = this.questions[0];
        return;
      }
      this.typeLoop(0);
    },
    typeLoop(qi) {
      const q = this.questions[qi % this.questions.length];
      this.typeQuestion(q, () => {
        setTimeout(() => this.eraseQuestion(() => this.typeLoop(qi + 1)), 1900); // hold, then erase
      });
    },
    typeQuestion(text, done) {
      const chars = Array.from(text);
      let i = 0;
      const tick = () => {
        if (i < chars.length) { this.inputText += chars[i++]; setTimeout(tick, 55); }
        else done();
      };
      tick();
    },
    eraseQuestion(done) {
      const tick = () => {
        if (this.inputText.length) {
          const arr = Array.from(this.inputText); arr.pop(); this.inputText = arr.join('');
          setTimeout(tick, 25);
        } else { setTimeout(done, 350); }
      };
      tick();
    }
  };
}
</script>
