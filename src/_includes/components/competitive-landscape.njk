<section class="pt-20 pb-14 section-reveal bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Left: copy -->
      <div>
        <p class="text-xs tracking-widest uppercase text-stella-forest font-medium mb-4">Landscape</p>
        <h2 data-reveal="headline" class="text-h2 font-light text-stella-text mb-5">Where Stella<br>Stands</h2>
        <p data-reveal="subhead" class="text-body-lg text-stella-muted mb-8 leading-relaxed">
          Most commerce tools answer questions. Stella closes sales. No other platform combines full buying-journey autonomy with plug-in-simple setup for growing stores.
        </p>

<a href="/schedule-demo/" class="bg-stella-gradient text-stella-forest font-semibold rounded-xl px-8 py-3.5 text-sm hover:opacity-90 transition-opacity shadow-sm inline-flex items-center justify-center">
          {{ site.cta.primary }} →
        </a>
      </div>

      <!-- Right: quadrant chart -->
      <div id="landscape-chart" class="relative w-full" style="height: clamp(320px, 50vw, 380px);">
        <div class="absolute inset-0 bg-white rounded-3xl shadow-stella overflow-hidden p-8 sm:p-6">

          <!-- LEADERS tinted bg (top-right quadrant) -->
          <div class="absolute top-[10%] left-[50%] right-[4%] bottom-[50%] bg-stella-green/10 rounded-xl pointer-events-none"></div>

          <!-- Axis lines (start hidden, fade in via JS) -->
          <div id="landscape-axes" class="absolute inset-8 sm:inset-6 opacity-0">
            <!-- Vertical axis line -->
            <div id="landscape-vline" class="absolute left-1/2 top-0 bottom-0 w-px bg-stella-border"></div>
            <!-- Horizontal axis line -->
            <div id="landscape-hline" class="absolute top-1/2 left-0 right-0 h-px bg-stella-border"></div>

            <!-- Quadrant labels (hidden on mobile to avoid overlap with dots) -->
            <span class="hidden sm:inline absolute top-1 left-2 text-[10px] tracking-widest uppercase text-stella-muted font-medium">Enterprise</span>
            <span class="hidden sm:inline absolute top-1 right-2 text-[10px] tracking-widest uppercase text-stella-forest font-semibold">Leaders</span>
            <span class="hidden sm:inline absolute bottom-1 left-2 text-[10px] tracking-widest uppercase text-stella-muted font-medium">Legacy</span>
            <span class="hidden sm:inline absolute bottom-1 right-2 text-[10px] tracking-widest uppercase text-stella-muted font-medium">Chatbots</span>

            <!-- Y-axis label (anchored to bottom-left corner on mobile, mid-left on desktop) -->
            <span class="absolute left-1 bottom-1 origin-bottom-left sm:left-[-18px] sm:top-1/4 sm:bottom-auto sm:-translate-y-1/2 sm:origin-center -rotate-90 text-[9px] tracking-widest uppercase text-stella-muted whitespace-nowrap">Full Autonomy ↑</span>

            <!-- X-axis label (pulled inside chart on mobile) -->
            <span class="absolute bottom-1 sm:bottom-[-18px] right-0 text-[9px] tracking-widest uppercase text-stella-muted whitespace-nowrap">SMB-Ready →</span>
          </div>

          <!-- Dots (positioned absolutely within the card) -->

          {% for comp in competitors %}
          {% if comp.stella %}
          <div class="landscape-dot absolute" style="left:{{ comp.left }};top:{{ comp.top }};transform:translate(-50%,-50%)">
            <div class="w-5 h-5 rounded-full bg-stella-green border-2 border-stella-forest shadow-[0_0_0_4px_rgba(134,239,172,0.25)]"></div>
            <span class="absolute top-6 left-1/2 -translate-x-1/2 text-[10px] text-stella-forest font-bold whitespace-nowrap">{{ comp.name }}</span>
          </div>
          {% else %}
          <div class="landscape-dot absolute" style="left:{{ comp.left }};top:{{ comp.top }};transform:translate(-50%,-50%)">
            <div class="w-2.5 h-2.5 rounded-full bg-stella-muted/40 border border-stella-muted/30"></div>
            <span class="absolute top-3.5 left-1/2 -translate-x-1/2 text-[9px] text-stella-muted whitespace-nowrap font-medium">{{ comp.name }}</span>
          </div>
          {% endif %}
          {% endfor %}

        </div>
      </div>

    </div>
  </div>
</section>
