<style>.pin-spacer:has(#hiw-section){background:#fff}</style>
<section id="hiw-section" class="pt-10 pb-6 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <!-- Header -->
    <div id="hiw-header" class="text-center mb-8">
      <p class="text-xs tracking-widest uppercase text-stella-forest font-medium mb-2">How it works</p>
      <h2 class="text-h2 font-light text-stella-text">Three steps to your first sale.</h2>
      <p class="mt-3 text-lg text-stella-muted">Your agentic storefront, live in three steps.</p>
    </div>

    <!-- ── DESKTOP ── -->
    <div id="hiw-desktop" class="hidden lg:block">

      <!-- Tab row -->
      <div id="hiw-tabs" class="relative flex justify-center gap-16 pb-5">

        {% for step in steps %}
        <div class="hiw-tab cursor-default select-none" data-idx="{{ loop.index0 }}"{% if loop.index0 > 0 %} style="opacity:0.35"{% endif %}>
          <p class="text-xs text-stella-muted mb-1 font-mono">{{ step.num }}</p>
          <h3 class="tab-name text-[2rem] font-bold text-stella-text leading-none tracking-tight">{{ step.name }}</h3>
        </div>
        {% endfor %}

        <!-- Full-width border -->
        <div class="absolute bottom-0 left-0 right-0 h-px bg-stella-border"></div>
        <!-- Sliding active indicator -->
        <div id="hiw-indicator" class="absolute bottom-0 left-0 h-0.5 bg-stella-forest" style="width:0px"></div>
      </div>

      <!-- Step descriptions (swap on step change) -->
      <div class="relative mt-4 mb-5 h-5 overflow-hidden text-center">
        {% for step in steps %}
        <p class="hiw-desc absolute inset-x-0 text-sm text-stella-muted text-center" data-idx="{{ loop.index0 }}"{% if loop.index0 > 0 %} style="opacity:0"{% endif %}>{{ step.desc }}</p>
        {% endfor %}
      </div>

      <!-- Panel container — shadow wrapper outside clip so shadow isn't clipped -->
      <div class="-mx-1 px-1 pb-2">
      <div class="rounded-2xl shadow-stella">
      <div id="hiw-panel-wrap" class="rounded-2xl overflow-hidden" style="height:clamp(300px,calc(100vh - 330px),420px)">
      <div id="hiw-panels-inner" style="display:flex;gap:24px;height:100%;will-change:transform">

        <!-- Panel 1: Code editor -->
        <div id="hiw-panel-1" class="flex flex-col shrink-0 basis-full bg-[#0d1117] border border-white/10">
          <div class="flex items-center gap-1.5 px-4 py-3 border-b border-white/10 shrink-0">
            <span class="w-3 h-3 rounded-full bg-[#ff5f57]"></span>
            <span class="w-3 h-3 rounded-full bg-[#ffbd2e]"></span>
            <span class="w-3 h-3 rounded-full bg-[#28c840]"></span>
            <span class="ml-3 text-white/35 text-xs font-mono">terminal</span>
          </div>
          <div class="flex-1 p-5 font-mono text-[13px] leading-7 overflow-hidden">
            <div class="text-[#8b949e] text-xs mb-3"># Step 1 — retrieve your product catalog</div>
            <div class="bg-[#86efac]/10 border-l-2 border-[#86efac] pl-3 pr-3 py-2.5 rounded-r-lg space-y-0.5">
              <div>
                <span class="text-[#8b949e] text-xs select-none">$ </span><span class="text-[#7ee787] text-xs">curl</span><span class="text-white/70 text-xs"> https://api.stella-commerce.com/api/storefront/products \</span>
              </div>
              <div class="pl-4">
                <span class="text-[#79c0ff] text-xs">-H </span><span class="text-white/50 text-xs">"</span><span class="text-[#a5d6ff] text-xs">X-Stella-Token: </span><span class="text-[#ffa657] text-xs">stk_live_···</span><span class="text-white/50 text-xs">" \</span>
              </div>
              <div class="pl-4">
                <span class="text-[#79c0ff] text-xs">-H </span><span class="text-white/50 text-xs">"</span><span class="text-[#a5d6ff] text-xs">X-Site-ID: </span><span class="text-[#ffa657] text-xs">&lt;your_site_id&gt;</span><span class="text-white/50 text-xs">"</span><span id="hiw-cursor" class="inline-block w-1.5 h-[14px] bg-[#86efac] ml-0.5 align-middle"></span>
              </div>
            </div>
            <div class="mt-4 text-[#8b949e] text-xs mb-1"># Response</div>
            <div class="text-[#8b949e] text-xs">&#123; <span class="text-[#79c0ff]">"products"</span>: [ &#123; <span class="text-[#79c0ff]">"id"</span>: <span class="text-[#ffa657]">"prod_···"</span>, <span class="text-[#79c0ff]">"title"</span>: <span class="text-[#a5d6ff]">"Nike Air"</span>, ...</div>
          </div>
          <div class="px-5 py-3 border-t border-white/10 flex items-center gap-2 shrink-0">
            <span class="w-2 h-2 rounded-full bg-[#10B981] animate-pulse"></span>
            <span class="text-[#86efac] text-xs font-mono">Connected · stk_live_··· verified · Ready</span>
          </div>
        </div>

        <!-- Panel 2: Settings -->
        <div id="hiw-panel-2" class="flex flex-col shrink-0 basis-full bg-white border-2 border-stella-border">
          <div class="flex items-center gap-3 px-5 py-3.5 border-b border-stella-border shrink-0">
            <div class="w-2 h-2 rounded-full bg-stella-emerald animate-pulse"></div>
            <span class="text-sm font-semibold text-stella-text">Stella Dashboard</span>
            <span class="text-xs text-stella-muted ml-1">/ Settings</span>
          </div>
          <div class="flex-1 p-5 overflow-hidden">
            <p class="text-xs font-semibold text-stella-muted uppercase tracking-wider mb-4">Integrations</p>
            <div class="space-y-2.5">

              <div class="flex items-center justify-between p-3 rounded-xl border-2 border-stella-border">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-xl bg-stella-green/25 flex items-center justify-center text-base">📦</div>
                  <div>
                    <p class="text-sm font-medium text-stella-text">Product Catalog</p>
                    <p class="text-xs text-stella-muted">248 products synced</p>
                  </div>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-stella-emerald"></span>
                  <span class="text-xs font-semibold text-stella-forest">Live</span>
                </div>
              </div>

              <div class="flex items-center justify-between p-3 rounded-xl border-2 border-stella-border">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-xl bg-green-100 flex items-center justify-center font-bold text-green-700 text-xs">eS</div>
                  <div>
                    <p class="text-sm font-medium text-stella-text">eSewa</p>
                    <p class="text-xs text-stella-muted">Payment gateway</p>
                  </div>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-stella-emerald"></span>
                  <span class="text-xs font-semibold text-stella-forest">Connected</span>
                </div>
              </div>

              <div class="flex items-center justify-between p-3 rounded-xl border-2 border-stella-border">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-xl bg-purple-100 flex items-center justify-center font-bold text-purple-700 text-xs">Kh</div>
                  <div>
                    <p class="text-sm font-medium text-stella-text">Khalti</p>
                    <p class="text-xs text-stella-muted">Payment gateway</p>
                  </div>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-stella-emerald animate-pulse"></span>
                  <span class="text-xs font-semibold text-stella-forest">Connecting…</span>
                </div>
              </div>

              <div class="flex items-center justify-between p-3 rounded-xl border-2 border-stella-border">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-xl bg-blue-100 flex items-center justify-center font-bold text-blue-700 text-xs">WA</div>
                  <div>
                    <p class="text-sm font-medium text-stella-text">WhatsApp</p>
                    <p class="text-xs text-stella-muted">Messaging channel</p>
                  </div>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-stella-emerald"></span>
                  <span class="text-xs font-semibold text-stella-forest">Connected</span>
                </div>
              </div>

            </div>
          </div>
        </div>

        <!-- Panel 3: Live Orders Feed -->
        <div id="hiw-panel-3" class="flex flex-col shrink-0 basis-full bg-white border-2 border-stella-border">
          <div class="flex items-center justify-between px-5 py-3.5 bg-stella-bg border-b border-stella-border shrink-0">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-stella-emerald animate-pulse"></span>
              <span class="text-sm font-semibold text-stella-text">Orders · today</span>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-xs text-stella-muted uppercase tracking-wider">Revenue</span>
              <span class="text-sm font-bold text-stella-forest">₨ 48,200</span>
            </div>
          </div>
          <div class="flex-1 overflow-hidden">

            <div class="grid grid-cols-[auto_1fr_auto_5.5rem] items-center gap-4 px-5 py-2.5">
              <span class="text-xs font-mono text-stella-muted">#4821</span>
              <span class="text-sm font-medium text-stella-text">Nike Air Max <span class="text-stella-muted font-normal">· 41</span></span>
              <span class="text-sm font-semibold text-stella-forest">₨ 2,400</span>
              <span class="justify-self-end text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-md bg-green-100 text-green-700">WhatsApp</span>
            </div>

            <div class="grid grid-cols-[auto_1fr_auto_5.5rem] items-center gap-4 px-5 py-2.5 border-t border-stella-border/60">
              <span class="text-xs font-mono text-stella-muted">#4820</span>
              <span class="text-sm font-medium text-stella-text">Puma RX <span class="text-stella-muted font-normal">· 42</span></span>
              <span class="text-sm font-semibold text-stella-forest">₨ 1,800</span>
              <span class="justify-self-end text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-md bg-stella-lime/40 text-stella-forest">Web</span>
            </div>

            <div class="grid grid-cols-[auto_1fr_auto_5.5rem] items-center gap-4 px-5 py-2.5 border-t border-stella-border/60">
              <span class="text-xs font-mono text-stella-muted">#4819</span>
              <span class="text-sm font-medium text-stella-text">CloudWalk Pro <span class="text-stella-muted font-normal">· 40</span></span>
              <span class="text-sm font-semibold text-stella-forest">₨ 2,100</span>
              <span class="justify-self-end text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-md bg-green-100 text-green-700">WhatsApp</span>
            </div>

            <div class="grid grid-cols-[auto_1fr_auto_5.5rem] items-center gap-4 px-5 py-2.5 border-t border-stella-border/60">
              <span class="text-xs font-mono text-stella-muted">#4818</span>
              <span class="text-sm font-medium text-stella-text">Adidas Lite <span class="text-stella-muted font-normal">· 41</span></span>
              <span class="text-sm font-semibold text-stella-forest">₨ 1,950</span>
              <span class="justify-self-end text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-md bg-stella-lime/40 text-stella-forest">Web</span>
            </div>

            <div class="grid grid-cols-[auto_1fr_auto_5.5rem] items-center gap-4 px-5 py-2.5 border-t border-stella-border/60">
              <span class="text-xs font-mono text-stella-muted">#4817</span>
              <span class="text-sm font-medium text-stella-text">Bata Classic <span class="text-stella-muted font-normal">· 43</span></span>
              <span class="text-sm font-semibold text-stella-forest">₨ 1,650</span>
              <span class="justify-self-end text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-md bg-pink-100 text-pink-700">Instagram</span>
            </div>

          </div>
          <div class="flex items-center justify-between px-5 py-3 border-t border-stella-border shrink-0">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-stella-emerald inline-block animate-pulse"></span>
              <span class="text-xs text-stella-muted">Stella is processing <span class="text-stella-text font-medium">3 more</span></span>
            </div>
            <span class="text-xs text-stella-muted">No staff involved</span>
          </div>
        </div>

      </div><!-- /hiw-panels-inner -->
      </div><!-- /hiw-panel-wrap -->
      </div><!-- /shadow wrapper -->
      </div><!-- /outer wrapper -->


    </div>

    <!-- ── MOBILE ── -->
    <div class="lg:hidden space-y-12">

      {% for step in steps %}
      <div class="hiw-mobile-step">
        <div class="mb-3">
          <p class="text-xs font-mono text-stella-muted mb-1">{{ step.num }}</p>
          <h3 class="text-2xl font-bold text-stella-text tracking-tight">{{ step.name }}</h3>
        </div>
        <p class="text-sm text-stella-muted leading-relaxed mb-4">{{ step.desc }}</p>
        <div class="relative">
          <div class="absolute -inset-4 rounded-3xl bg-stella-green blur-[60px] opacity-30 pointer-events-none" aria-hidden="true"></div>
          <div class="relative">
        {% if loop.index0 == 0 %}
        <div class="rounded-xl border border-stella-border bg-[#0d1117] p-3 sm:p-4 overflow-x-auto">
          <div class="font-mono text-xs leading-6 whitespace-nowrap">
            <div><span class="text-[#8b949e]">$ </span><span class="text-[#7ee787]">curl</span><span class="text-white/70"> https://api.stella-commerce.com/...</span></div>
            <div class="pl-4"><span class="text-[#79c0ff]">-H </span><span class="text-[#a5d6ff]">"X-Stella-Token: </span><span class="text-[#ffa657]">stk_live_···</span><span class="text-[#a5d6ff]">"</span></div>
            <div class="pl-4"><span class="text-[#79c0ff]">-H </span><span class="text-[#a5d6ff]">"X-Site-ID: </span><span class="text-[#ffa657]">&lt;your_site_id&gt;</span><span class="text-[#a5d6ff]">"</span></div>
          </div>
          <div class="mt-2.5 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>
            <span class="text-[#86efac] text-xs font-mono">Connected · stk_live_··· verified</span>
          </div>
        </div>
        {% elif loop.index0 == 1 %}
        <div class="rounded-xl border border-stella-border bg-white p-4 space-y-2.5">
          <div class="flex items-center justify-between text-sm">
            <span class="font-medium text-stella-text">eSewa</span>
            <span class="text-stella-forest font-semibold flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-stella-emerald inline-block"></span> Connected</span>
          </div>
          <div class="flex items-center justify-between text-sm">
            <span class="font-medium text-stella-text">Khalti</span>
            <span class="text-stella-forest font-semibold flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-stella-emerald inline-block"></span> Connected</span>
          </div>
          <div class="flex items-center justify-between text-sm">
            <span class="font-medium text-stella-text">Product Catalog</span>
            <span class="text-stella-forest font-semibold flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-stella-emerald inline-block"></span> 248 synced</span>
          </div>
        </div>
        {% else %}
        <div class="rounded-xl border border-stella-border bg-white overflow-hidden">
          <div class="flex items-center justify-between px-4 py-2.5 bg-stella-bg border-b border-stella-border">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-stella-emerald inline-block animate-pulse"></span>
              <span class="text-xs font-semibold text-stella-text">Orders · today</span>
            </div>
            <span class="text-xs font-bold text-stella-forest">₨ 48,200</span>
          </div>
          <div class="divide-y divide-stella-border/60">
            <div class="flex items-center gap-2 px-4 py-2 text-xs">
              <span class="font-mono text-stella-muted">#4821</span>
              <span class="flex-1 font-medium text-stella-text truncate">Nike Air Max</span>
              <span class="font-semibold text-stella-forest">₨ 2,400</span>
              <span class="text-[9px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded bg-green-100 text-green-700">WA</span>
            </div>
            <div class="flex items-center gap-2 px-4 py-2 text-xs">
              <span class="font-mono text-stella-muted">#4820</span>
              <span class="flex-1 font-medium text-stella-text truncate">Puma RX</span>
              <span class="font-semibold text-stella-forest">₨ 1,800</span>
              <span class="text-[9px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded bg-stella-lime/40 text-stella-forest">Web</span>
            </div>
            <div class="flex items-center gap-2 px-4 py-2 text-xs">
              <span class="font-mono text-stella-muted">#4819</span>
              <span class="flex-1 font-medium text-stella-text truncate">CloudWalk</span>
              <span class="font-semibold text-stella-forest">₨ 2,100</span>
              <span class="text-[9px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded bg-green-100 text-green-700">WA</span>
            </div>
          </div>
          <div class="flex items-center gap-2 px-4 py-2 border-t border-stella-border text-xs text-stella-muted">
            <span class="w-1.5 h-1.5 rounded-full bg-stella-emerald inline-block animate-pulse"></span>
            <span>3 more processing · no staff involved</span>
          </div>
        </div>
        {% endif %}
          </div>
        </div>
      </div>
      {% endfor %}

    </div>

  </div>
</section>
