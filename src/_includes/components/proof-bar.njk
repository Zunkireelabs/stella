<section class="pt-12 pb-8 bg-white">
  <div class="max-w-5xl mx-auto relative group">

  <!-- Left fade mask -->
  <div class="absolute inset-y-0 left-0 w-12 sm:w-24 md:w-48 z-10 pointer-events-none" style="background:linear-gradient(to right,#ffffff 40%,transparent)"></div>
  <!-- Right fade mask -->
  <div class="absolute inset-y-0 right-0 w-12 sm:w-24 md:w-48 z-10 pointer-events-none" style="background:linear-gradient(to left,#ffffff 40%,transparent)"></div>

  {% set brandClasses = [
    "text-lg font-bold text-stella-text/40",
    "text-lg font-black text-stella-text/50 tracking-tight",
    "text-lg font-semibold text-stella-text/40 tracking-widest uppercase text-sm",
    "text-lg font-bold text-stella-text/40",
    "text-lg font-extrabold text-stella-text/50 tracking-tight",
    "text-lg font-semibold text-stella-text/40 tracking-widest uppercase text-sm",
    "text-lg font-bold text-stella-text/40",
    "text-lg font-black text-stella-text/50 tracking-tight",
    "text-lg font-semibold text-stella-text/40 tracking-widest uppercase text-sm",
    "text-lg font-bold text-stella-text/40"
  ] %}

  <!-- Marquee -->
  <div class="flex overflow-hidden">
    <div class="flex items-center gap-20 animate-marquee whitespace-nowrap group-hover:[animation-play-state:paused]">

      {% for brand in brands %}
      <span class="{{ brandClasses[loop.index0] }}">{{ brand }}</span>
      {% endfor %}

      {% for brand in brands %}
      <span class="{{ brandClasses[loop.index0] }}">{{ brand }}</span>
      {% endfor %}

    </div>
  </div>

  <!-- Hover: blur overlay -->
  <div class="absolute inset-0 z-20 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300 backdrop-blur-sm"></div>

  <!-- Hover: pill CTA -->
  <div class="absolute inset-0 flex items-center justify-center z-30 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300">
    <a href="/customer-stories/" class="pointer-events-auto relative overflow-hidden bg-stella-gradient text-stella-forest font-semibold text-sm rounded-xl px-8 py-3.5 shadow-sm inline-flex items-center justify-center">
      <span class="btn-glow-layer absolute inset-0 rounded-xl pointer-events-none opacity-0" style="--mouse-x:50%;--mouse-y:50%;background: radial-gradient(circle 100px at var(--mouse-x) var(--mouse-y), rgba(255,255,255,0.65), transparent);"></span>
      <span class="relative z-10">Meet our stores →</span>
    </a>
  </div>

  </div>
</section>
