<section class="pt-16 pb-12 section-reveal bg-white">
  <div class="max-w-5xl mx-auto px-6">

    <p data-reveal="subhead" class="text-xs tracking-widest uppercase text-stella-forest font-medium mb-12">Results</p>

    {% for metric in metrics %}
    <div class="group relative cursor-default">
      <div class="relative h-px w-full mb-0">
        <div class="absolute inset-0 bg-stella-border"></div>
        <div class="absolute inset-0 bg-stella-lime opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-0 py-8 transition-colors duration-300 group-hover:bg-stella-green/[0.03] px-1">
        <div class="sm:w-2/5 shrink-0">
          <p class="text-[2.2rem] sm:text-[3.5rem] md:text-[4.5rem] lg:text-[5.5rem] font-bold leading-none tracking-tight transition-colors duration-300 bg-clip-text bg-stella-lime text-transparent sm:bg-none sm:text-stella-text sm:group-hover:bg-stella-lime sm:group-hover:text-transparent"
             {% if metric.count %}data-count data-target="{{ metric.target }}" data-suffix="{{ metric.suffix }}"{% endif %}>{{ metric.value }}</p>
        </div>
        <div class="sm:w-3/5">
          <p class="text-base sm:text-lg font-semibold text-stella-forest sm:text-stella-text mb-1">{{ metric.label }}</p>
          <p class="text-sm text-stella-muted leading-relaxed">{{ metric.desc }}</p>
        </div>
      </div>
    </div>
    {% endfor %}

    <!-- Final bottom divider -->
    <div class="h-px w-full bg-stella-border"></div>

  </div>
</section>
