<div class="hidden lg:block">
<section id="stella-universe-section" class="relative overflow-hidden" style="height: 100vh; background: #ffffff;">

  <!-- Ambient layer (fades out as clip expands) -->
  <div id="stella-outside" class="absolute inset-0 flex flex-col pointer-events-none" style="background: #ffffff; z-index: 1;">
    <div class="pt-10 pb-4 text-center">
      <p class="text-xs tracking-widest uppercase text-stella-forest font-medium mb-4">Live Demo</p>
      <h2 class="text-h2 font-light text-stella-text">One backend. Every channel.</h2>
      <p class="mt-3 text-lg text-stella-muted">Scroll to see Stella sell through Instagram — live inside your dashboard.</p>
    </div>
    <div class="mt-auto pb-12 text-center">
      <p class="text-sm text-stella-muted">
        Want this on your storefront?
        <a href="/schedule-demo/" class="text-stella-forest font-semibold hover:underline ml-1">{{ site.cta.primary }} →</a>
      </p>
    </div>
  </div>

  <!-- Green ring indicator (sits above frame, blooms out on expand) -->
  <style>
    @property --ring-angle {
      syntax: '<angle>';
      initial-value: 0deg;
      inherits: false;
    }
    @keyframes ring-arc-spin {
      to { --ring-angle: 360deg; }
    }
    @keyframes ring-pulse {
      0%, 100% { box-shadow: 0 20px 48px rgba(0,0,0,0.13), 0 0 0 0 rgba(74,222,128,0); }
      50%       { box-shadow: 0 20px 48px rgba(0,0,0,0.18), 0 0 22px 6px rgba(74,222,128,0.22); }
    }
    @keyframes tile-flash {
      0%   { box-shadow: 0 0 0 0 rgba(16,185,129,0.0); transform: scale(1); }
      30%  { box-shadow: 0 0 0 6px rgba(16,185,129,0.35); transform: scale(1.02); }
      100% { box-shadow: 0 0 0 0 rgba(16,185,129,0.0); transform: scale(1); }
    }
    .tile-flash { animation: tile-flash 1.1s ease-out; }
    @keyframes ig-typing {
      0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
      30%           { transform: translateY(-3px); opacity: 1; }
    }
    .ig-dot { animation: ig-typing 1.2s ease-in-out infinite; }
    .ig-dot:nth-child(2) { animation-delay: 0.15s; }
    .ig-dot:nth-child(3) { animation-delay: 0.3s; }
    .ig-gradient-bg {
      background: linear-gradient(95deg, #833AB4 0%, #C13584 40%, #FD1D1D 70%, #FCAF45 100%);
    }
    .ig-ring {
      background: linear-gradient(45deg, #FCAF45, #FD1D1D, #C13584, #833AB4);
      padding: 2px;
      border-radius: 9999px;
    }
  </style>
  <div id="universe-ring" class="absolute pointer-events-none rounded-[22px]"
       style="z-index: 3; box-shadow: 0 20px 48px rgba(0,0,0,0.13); width: 640px; height: 460px; left: 50%; top: calc(50% + 40px); transform: translate(-50%,-50%); animation: ring-pulse 2.4s ease-in-out infinite;">
    <span style="position:absolute;inset:0;border-radius:22px;padding:3px;background:conic-gradient(from var(--ring-angle) at 50% 50%, transparent 0%, rgba(134,239,172,0.5) 8%, rgba(134,239,172,1) 15%, #10B981 18%, rgba(134,239,172,1) 21%, rgba(134,239,172,0.5) 28%, transparent 36%, transparent 100%) border-box;-webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);-webkit-mask-composite:xor;mask-composite:exclude;animation:ring-arc-spin 2.8s linear infinite;pointer-events:none;"></span>
  </div>

  <!-- Window frame: full-size, clip-path reveals it as small centered window initially -->
  <div id="stella-window-frame" class="absolute inset-0 overflow-hidden" style="z-index: 2; background: #f7ffe4;">

    <!-- Cinematic vignette — blooms in during aperture transition, clears when fully open -->
    <div id="universe-vignette" class="absolute inset-0 pointer-events-none" style="z-index: 10; opacity: 0; background: radial-gradient(ellipse 70% 65% at 50% 50%, transparent, rgba(0,0,0,0.18));"></div>

    <!-- ── COMPACT PREVIEW — centered card matching the clip window ── -->
    <div id="window-preview" class="absolute inset-0 flex items-center justify-center" style="padding-top: 80px;">
      <div id="window-preview-card" class="relative flex flex-col overflow-hidden" style="width:640px;height:460px;background:#f7ffe4;">


        <!-- Splash content -->
        <div class="relative flex-1 flex flex-col items-center justify-center text-center px-8" style="z-index:1;">
          <h2 class="font-pacifico text-[5.5rem] leading-none text-stella-forest">Stella</h2>
          <p class="mt-3 text-base text-stella-muted">AI that sells for you. Around the clock.</p>
        </div>

        <!-- Scroll cue -->
        <style>
          @keyframes cue-float {
            0%        { transform: translateY(0px);  animation-timing-function: ease-in; }
            45%       { transform: translateY(12px); animation-timing-function: ease-out; }
            100%      { transform: translateY(0px); }
          }
          #window-scroll-cue { animation: cue-float 2.4s ease-in-out infinite; }
        </style>
        <div id="window-scroll-cue" class="relative shrink-0 pb-7 flex flex-col items-center gap-1" style="z-index:1;">
          <p class="text-xs text-stella-muted tracking-widest uppercase">scroll to enter</p>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stella-forest/50">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>

      </div>
    </div>
    <!-- END compact preview -->

    <!-- Demo data injection (avoids attribute-encoding issues) -->
    <script id="stella-demo-data" type="application/json">
      { "products": {{ demoProducts | dump | safe }}, "chat": {{ demoChat | dump | safe }} }
    </script>

    <!-- ── STELLA UNIVERSE (Alpine interactive demo) ── -->
    <div id="window-universe" class="absolute inset-0 flex gap-4 p-4" style="opacity: 0; background: #e8f1d0;"
         x-data="stellaDemo()"
         @mousemove="cursorX = $event.clientX; cursorY = $event.clientY"
         @mouseenter="cursorVisible = true"
         @mouseleave="cursorVisible = false">

      <!-- ════════════════ LEFT PANE — Instagram DM ════════════════ -->
      <div class="universe-stagger w-[420px] shrink-0 border border-stella-border rounded-2xl flex flex-col bg-white overflow-hidden shadow-sm">

        <!-- IG header -->
        <div class="shrink-0 px-4 py-2.5 flex items-center gap-3 border-b border-stella-border bg-white">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#262626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
          <div class="ig-ring shrink-0">
            <div class="w-9 h-9 rounded-full bg-white p-[2px]">
              <div class="w-full h-full rounded-full flex items-center justify-center text-white text-sm font-bold" style="background: linear-gradient(135deg, #166534, #10B981);">M</div>
            </div>
          </div>
          <div class="flex-1 min-w-0 leading-tight">
            <p class="text-sm font-semibold text-[#262626] truncate">{{ demoChat.storeHandle }}</p>
            <p class="text-[11px] text-[#8e8e8e]">Active now</p>
          </div>
          <div class="flex items-center gap-3 text-[#262626]">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
          </div>
        </div>

        <!-- Message thread -->
        <div class="flex-1 overflow-y-auto py-4 px-3 flex flex-col gap-2.5" data-chat-scroll x-ref="chatScroll" style="background:#ffffff;">

          <!-- Day separator -->
          <div class="flex items-center gap-2 my-1">
            <div class="flex-1 h-px bg-[#efefef]"></div>
            <span class="text-[10px] uppercase tracking-wider text-[#8e8e8e] font-semibold">Today · Instagram DM</span>
            <div class="flex-1 h-px bg-[#efefef]"></div>
          </div>

          <template x-for="(msg, i) in messages" :key="i">
            <div>
              <!-- Bot bubble (text + optional product cards) -->
              <template x-if="msg.role === 'bot'">
                <div class="flex flex-col items-start gap-1.5 max-w-[85%]">
                  <div x-show="msg.text" class="bg-[#efefef] text-[#262626] text-sm px-3.5 py-2 rounded-2xl rounded-bl-md" x-text="msg.text"></div>

                  <!-- Inline product cards (display only — order is placed conversationally) -->
                  <template x-if="msg.productIds && msg.productIds.length">
                    <div class="flex flex-col gap-1.5 w-[280px]">
                      <template x-for="(pid, idx) in msg.productIds" :key="pid">
                        <div class="bg-white border border-[#dbdbdb] rounded-2xl rounded-bl-md overflow-hidden flex items-center gap-3 p-2">
                          <div class="relative shrink-0">
                            <img :src="productById(pid).image" :alt="productById(pid).name" class="w-14 h-14 rounded-xl object-cover bg-[#f5f5f5]">
                            <span class="absolute -top-1 -left-1 w-4 h-4 rounded-full bg-[#262626] text-white text-[9px] font-bold flex items-center justify-center" x-text="idx + 1"></span>
                          </div>
                          <div class="flex-1 min-w-0">
                            <p class="text-[13px] font-semibold text-[#262626] leading-tight truncate" x-text="productById(pid).name"></p>
                            <p class="text-[11px] text-[#8e8e8e] mt-0.5" x-text="formatPrice(productById(pid).price)"></p>
                            <p x-show="stock[pid] <= 0" class="text-[10px] font-semibold text-red-500 mt-0.5">Sold out</p>
                          </div>
                        </div>
                      </template>
                    </div>
                  </template>
                </div>
              </template>

              <!-- Shopper bubble -->
              <template x-if="msg.role === 'user'">
                <div class="flex justify-end">
                  <div class="ig-gradient-bg text-white text-sm px-3.5 py-2 rounded-2xl rounded-br-md max-w-[80%]" x-text="msg.text"></div>
                </div>
              </template>
            </div>
          </template>

          <!-- Typing indicator -->
          <div x-show="typing" class="flex items-center gap-1 bg-[#efefef] w-fit px-3.5 py-2.5 rounded-2xl rounded-bl-md">
            <span class="ig-dot w-1.5 h-1.5 rounded-full bg-[#8e8e8e]"></span>
            <span class="ig-dot w-1.5 h-1.5 rounded-full bg-[#8e8e8e]"></span>
            <span class="ig-dot w-1.5 h-1.5 rounded-full bg-[#8e8e8e]"></span>
          </div>
        </div>

        <!-- Suggested prompts -->
        <div class="shrink-0 px-3 pb-2 pt-2 flex gap-1.5 overflow-x-auto border-t border-[#efefef]" style="scrollbar-width:none;">
          <template x-for="prompt in suggestedPrompts" :key="prompt">
            <button @click="sendPrompt(prompt)" class="shrink-0 text-[11px] text-[#262626] border border-[#dbdbdb] rounded-full px-3 py-1 hover:bg-[#f5f5f5] transition-colors whitespace-nowrap" x-text="prompt"></button>
          </template>
        </div>

        <!-- IG composer -->
        <div class="shrink-0 px-3 py-2.5 flex items-center gap-2 border-t border-[#efefef] bg-white">
          <div class="w-8 h-8 rounded-full ig-gradient-bg flex items-center justify-center shrink-0">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
          </div>
          <div class="flex-1 flex items-center bg-white border border-[#dbdbdb] rounded-full px-3.5 py-1.5">
            <input type="text"
              placeholder="Message..."
              x-model="userInput"
              @keydown.enter="send()"
              class="flex-1 bg-transparent text-sm text-[#262626] placeholder:text-[#8e8e8e] focus:outline-none">
            <template x-if="!userInput">
              <div class="flex items-center gap-2 text-[#262626]">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="23"></line><line x1="8" y1="23" x2="16" y2="23"></line></svg>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
              </div>
            </template>
            <template x-if="userInput">
              <button @click="send()" class="text-sm font-semibold text-[#0095f6] ml-2">Send</button>
            </template>
          </div>
        </div>

      </div>
      <!-- END Instagram DM left pane -->

      <!-- ════════════════ RIGHT PANE — Stella Backend Dashboard ════════════════ -->
      <div class="universe-stagger flex-1 flex min-w-0 relative border border-stella-border rounded-2xl overflow-hidden shadow-sm bg-white">

        <!-- Order notification card -->
        <style>
          @keyframes order-notify-in {
            0%   { transform: translate3d(20px, 0, 0); opacity: 0; }
            60%  { transform: translate3d(-4px, 0, 0); opacity: 1; }
            100% { transform: translate3d(0, 0, 0); opacity: 1; }
          }
          @keyframes order-row-pulse {
            0%, 100% { background-color: rgba(134, 239, 172, 0.0); }
            40%      { background-color: rgba(134, 239, 172, 0.45); }
          }
          .order-notify-card { animation: order-notify-in 0.5s cubic-bezier(0.22, 0.61, 0.36, 1); }
          .order-row-fresh   { animation: order-row-pulse 2.4s ease-out; }
        </style>
        <div x-show="orderNotice"
             x-transition:leave="transition ease-in duration-200"
             x-transition:leave-start="opacity-100 translate-x-0"
             x-transition:leave-end="opacity-0 translate-x-4"
             class="order-notify-card absolute top-3 right-3 z-30 w-[260px] bg-white border border-stella-green rounded-2xl shadow-2xl overflow-hidden">
          <div class="flex items-center gap-1.5 px-3 py-1.5 bg-stella-forest text-white text-[10px] font-bold uppercase tracking-wider">
            <span class="w-1.5 h-1.5 rounded-full bg-stella-green animate-pulse"></span>
            New order · Instagram
          </div>
          <template x-if="orderNotice">
            <div class="flex items-center gap-2.5 p-2.5">
              <img :src="orderNotice.image" class="w-10 h-10 rounded-lg object-cover shrink-0 bg-[#f5f5f5]">
              <div class="flex-1 min-w-0">
                <p class="text-[11px] text-stella-muted">Order <span class="font-semibold text-stella-text">#<span x-text="orderNotice.orderId"></span></span></p>
                <p class="text-[12px] font-semibold text-stella-text truncate" x-text="orderNotice.name"></p>
                <p class="text-[11px] font-bold text-stella-forest" x-text="formatPrice(orderNotice.price)"></p>
              </div>
            </div>
          </template>
        </div>

        <!-- Dashboard left rail -->
        <div class="w-[170px] shrink-0 flex flex-col py-3 border-r border-stella-border bg-neutral-50">

          <div class="flex items-center gap-2 px-4 mb-4">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M6 0L7.4 4.6L12 6L7.4 7.4L6 12L4.6 7.4L0 6L4.6 4.6L6 0Z" fill="#166534"/>
            </svg>
            <span class="text-stella-forest font-bold text-sm tracking-tight">Stella</span>
          </div>

          <nav class="flex-1 space-y-0.5 px-2 pointer-events-none select-none">

            <div class="w-full flex items-center gap-2 px-3 py-2 rounded-xl text-stella-muted">
              <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M1 1h6v6H1V1zm0 8h6v6H1V9zm8-8h6v6H9V1zm0 8h6v6H9V9z"/></svg>
              <span class="text-xs">Overview</span>
            </div>

            <div class="w-full flex items-center gap-2 px-3 py-2 rounded-xl text-stella-muted">
              <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0L0 4v8l8 4 8-4V4L8 0zm0 1.9l6 3-6 3-6-3 6-3zM1 5.4l6.5 3.25v5.95L1 11.35V5.4zm8.5 9.2V8.65L15 5.4v5.95L9.5 14.6z"/></svg>
              <span class="text-xs">Catalog</span>
            </div>

            <div class="w-full flex items-center gap-2 px-3 py-2 rounded-xl bg-stella-forest/10 text-stella-forest font-semibold">
              <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor"><path d="M2 3a1 1 0 011-1h10a1 1 0 011 1v2H2V3zm0 3.5h12v7a1 1 0 01-1 1H3a1 1 0 01-1-1v-7zM5 8a.5.5 0 000 1h6a.5.5 0 000-1H5z"/></svg>
              <span class="text-xs">Products</span>
              <span class="ml-auto text-[9px] text-stella-forest/70 font-normal" x-text="products.length"></span>
            </div>

            <div class="w-full flex items-center gap-2 px-3 py-2 rounded-xl text-stella-muted">
              <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1a2.5 2.5 0 00-2.5 2.5H3l-1 11h12l-1-11h-2.5A2.5 2.5 0 008 1zm0 1.5a1 1 0 011 1H7a1 1 0 011-1z"/></svg>
              <span class="text-xs">Orders</span>
              <span class="ml-auto bg-stella-forest text-white text-[9px] font-bold rounded-full min-w-[16px] h-4 px-1 flex items-center justify-center" x-text="recentOrders.length"></span>
            </div>

            <div class="w-full flex items-center gap-2 px-3 py-2 rounded-xl text-stella-muted">
              <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor"><path d="M7 8a3 3 0 100-6 3 3 0 000 6zm-5 6s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H2zm10-6a2 2 0 100-4 2 2 0 000 4zm1 6h-1.5s.5-1 .5-2.5c.7.3 1 .8 1 1.5s-.5 1-.5 1H13z"/></svg>
              <span class="text-xs">Customers</span>
            </div>

            <div class="w-full flex items-center gap-2 px-3 py-2 rounded-xl text-stella-muted">
              <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor"><path d="M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.464 1.464 0 01-2.105.872l-.31-.17c-1.283-.698-2.686.705-1.987 1.987l.169.311c.446.82.023 1.841-.872 2.105l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1c.895.264 1.318 1.285.872 2.105l-.17.31c-.698 1.283.705 2.686 1.987 1.987l.311-.169a1.464 1.464 0 012.105.872l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.464 1.464 0 012.105-.872l.31.17c1.283.698 2.686-.705 1.987-1.987l-.169-.311a1.464 1.464 0 01.872-2.105l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.464 1.464 0 01-.872-2.105l.17-.31c.698-1.283-.705-2.686-1.987-1.987l-.311.169a1.464 1.464 0 01-2.105-.872l-.1-.34zM8 10.93a2.929 2.929 0 110-5.86 2.929 2.929 0 010 5.858z"/></svg>
              <span class="text-xs">Settings</span>
            </div>
          </nav>

          <div class="px-3 pt-3 mt-2 border-t border-stella-border">
            <div class="flex items-center gap-2">
              <div class="w-7 h-7 rounded-lg bg-stella-gradient flex items-center justify-center shrink-0">
                <span class="text-stella-forest text-[10px] font-bold">PS</span>
              </div>
              <div class="min-w-0">
                <p class="text-xs font-semibold text-stella-text truncate">Priya S.</p>
                <p class="text-[10px] text-stella-muted truncate">Owner</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Dashboard main content -->
        <div class="flex-1 flex flex-col min-w-0 bg-white">

          <!-- Header bar -->
          <div class="shrink-0 px-5 py-2.5 bg-neutral-50 flex items-center justify-between border-b border-stella-border">
            <div class="flex items-center gap-3">
              <span class="text-sm font-bold text-stella-forest">Products</span>
              <div class="flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-stella-forest animate-pulse"></span>
                <span class="text-[10px] font-semibold text-stella-forest">Live</span>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <div class="hidden md:flex items-center bg-white border border-stella-border rounded-lg px-2 py-1 gap-1.5">
                <svg width="10" height="10" viewBox="0 0 16 16" fill="#52645A"><path d="M11.742 10.344a6.5 6.5 0 10-1.397 1.398l3.85 3.85a1 1 0 001.415-1.415l-3.85-3.85zM12 6.5a5.5 5.5 0 11-11 0 5.5 5.5 0 0111 0z"/></svg>
                <span class="text-[10px] text-stella-muted">Search products...</span>
              </div>
              <button class="text-[11px] font-semibold text-stella-forest bg-stella-gradient rounded-lg px-3 py-1">+ New product</button>
            </div>
          </div>

          <!-- Products list (main view) -->
          <div class="flex-1 flex flex-col min-h-0 overflow-hidden">

            <!-- Table header -->
            <div class="shrink-0 grid grid-cols-[2fr_70px_80px_70px_60px] gap-3 px-5 py-2 border-b border-stella-border bg-neutral-50">
              <p class="text-[9px] font-semibold text-stella-muted uppercase tracking-wider">Product</p>
              <p class="text-[9px] font-semibold text-stella-muted uppercase tracking-wider">Price</p>
              <p class="text-[9px] font-semibold text-stella-muted uppercase tracking-wider">Stock</p>
              <p class="text-[9px] font-semibold text-stella-muted uppercase tracking-wider">Status</p>
              <p class="text-[9px] font-semibold text-stella-muted uppercase tracking-wider text-right">···</p>
            </div>

            <!-- Product rows -->
            <div class="flex-1 overflow-y-auto">
              <template x-for="product in products" :key="product.id">
                <div :class="['grid grid-cols-[2fr_70px_80px_70px_60px] gap-3 px-5 py-2.5 border-b border-stella-border/60 items-center hover:bg-neutral-50 transition-colors', flashingIds.includes(product.id) ? 'tile-flash' : '']">
                  <!-- Product image + name -->
                  <div class="flex items-center gap-2.5 min-w-0">
                    <img :src="product.image" :alt="product.name" class="w-9 h-9 rounded-lg object-cover shrink-0 bg-[#f5f5f5]">
                    <div class="min-w-0">
                      <div class="flex items-center gap-1.5">
                        <p class="text-[12px] font-semibold text-stella-text truncate" x-text="product.name"></p>
                        <span x-show="product.tag"
                              x-text="product.tag"
                              class="shrink-0 text-[8px] font-bold uppercase tracking-wide px-1.5 py-0.5 rounded"
                              :class="{
                                'bg-stella-forest text-white': product.tag === 'Bestseller',
                                'bg-stella-emerald text-white': product.tag === 'New',
                                'bg-amber-500 text-white': product.tag === 'Sale'
                              }"></span>
                      </div>
                      <p class="text-[10px] text-stella-muted capitalize" x-text="product.category + ' · SKU-' + String(product.id).padStart(4,'0')"></p>
                    </div>
                  </div>
                  <!-- Price -->
                  <p class="text-[11px] font-semibold text-stella-text" x-text="formatPrice(product.price)"></p>
                  <!-- Stock -->
                  <div class="flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full" :class="stock[product.id] > 5 ? 'bg-stella-emerald' : (stock[product.id] > 0 ? 'bg-amber-500' : 'bg-red-500')"></span>
                    <span class="text-[11px] font-medium text-stella-text" x-text="stock[product.id]"></span>
                  </div>
                  <!-- Status -->
                  <span class="inline-flex items-center text-[9px] font-semibold px-1.5 py-0.5 rounded-full"
                        :class="stock[product.id] > 0 ? 'bg-stella-green/25 text-stella-forest' : 'bg-red-100 text-red-700'"
                        x-text="stock[product.id] > 0 ? 'Active' : 'Sold out'"></span>
                  <!-- Actions -->
                  <div class="flex items-center justify-end gap-1 text-stella-muted">
                    <button class="hover:text-stella-forest p-1" aria-label="Edit">
                      <svg width="11" height="11" viewBox="0 0 16 16" fill="currentColor"><path d="M11.013 1.427a1.75 1.75 0 012.474 0l1.086 1.086a1.75 1.75 0 010 2.474l-8.61 8.61c-.21.21-.47.364-.756.445l-3.251.93a.75.75 0 01-.927-.928l.929-3.25c.081-.286.235-.547.445-.758l8.61-8.61z"/></svg>
                    </button>
                    <button class="hover:text-stella-forest p-1" aria-label="More">
                      <svg width="11" height="11" viewBox="0 0 16 16" fill="currentColor"><circle cx="3" cy="8" r="1.5"/><circle cx="8" cy="8" r="1.5"/><circle cx="13" cy="8" r="1.5"/></svg>
                    </button>
                  </div>
                </div>
              </template>
            </div>

            <!-- Footer: recent activity strip -->
            <div class="shrink-0 border-t border-stella-border bg-neutral-50" style="min-height: 110px; max-height: 130px;">

              <div class="flex flex-col min-h-0 overflow-hidden h-full">
                <p class="shrink-0 text-[9px] font-semibold text-stella-muted uppercase tracking-wider px-4 pt-2">Recent orders</p>
                <div class="flex-1 overflow-y-auto px-4 pb-2">
                  <template x-for="(o, i) in recentOrders.slice(0, 4)" :key="i + o.orderId + o.productName">
                    <div :class="['flex items-center gap-2 py-1 px-1 -mx-1 rounded', o.fresh ? 'order-row-fresh' : '']">
                      <div class="w-4 h-4 rounded-md bg-stella-green/25 shrink-0 flex items-center justify-center">
                        <svg width="8" height="8" viewBox="0 0 16 16" fill="#166534"><path d="M8 1a2.5 2.5 0 00-2.5 2.5H3l-1 11h12l-1-11h-2.5A2.5 2.5 0 008 1z"/></svg>
                      </div>
                      <p class="text-[10px] text-stella-text truncate flex-1">
                        <span class="text-stella-muted">#</span><span class="font-semibold" x-text="o.orderId"></span>
                        <span class="text-stella-muted mx-0.5">·</span><span x-text="o.productName"></span>
                        <span class="text-stella-forest font-semibold ml-1" x-text="formatPrice(o.price)"></span>
                      </p>
                      <span class="text-[9px] text-stella-muted shrink-0" x-text="o.at"></span>
                    </div>
                  </template>
                </div>
              </div>

            </div>

          </div>

        </div>
      </div>
      <!-- END dashboard right pane -->

      <!-- Scroll-to-exit cue -->
      <div id="universe-exit-cue"
           class="absolute bottom-5 left-1/2 -translate-x-1/2 flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium text-stella-forest/70 pointer-events-none select-none"
           style="opacity:0; background: rgba(134,239,172,0.3); backdrop-filter: blur(4px);">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        scroll to continue
      </div>

      <!-- Cursor interaction hint -->
      <div x-show="cursorVisible && messageCount === 0"
           x-transition:enter="transition duration-150 ease-out"
           x-transition:enter-start="opacity-0 scale-90"
           x-transition:enter-end="opacity-100 scale-100"
           x-transition:leave="transition duration-100 ease-in"
           x-transition:leave-start="opacity-100"
           x-transition:leave-end="opacity-0"
           :style="`position:fixed; left:${cursorX+16}px; top:${cursorY+16}px; z-index:50`"
           class="pointer-events-none ig-gradient-bg text-white text-[11px] font-semibold px-2.5 py-1 rounded-full shadow-lg whitespace-nowrap">
        💬 Try messaging
      </div>

    </div>
    <!-- END Stella Universe -->

  </div>
  <!-- END window frame -->

</section>
</div>

<!-- Mobile/tablet: interactive demo -->
<div class="lg:hidden py-20 px-6 text-center" x-data="{ demoOpen: false }">
  <p class="text-xs tracking-widest uppercase text-stella-forest font-medium mb-4">Live Demo</p>
  <h2 class="text-3xl font-light text-stella-text mb-3">One backend.<br>Every channel.</h2>
  <p class="mt-2 text-base text-stella-muted mb-6 max-w-md mx-auto">Shoppers chat on Instagram. Stella sells. Your dashboard captures every order — live.</p>

  <style>
    .ig-gradient-bg-m { background: linear-gradient(95deg, #833AB4, #C13584, #FD1D1D, #FCAF45); }
  </style>

  <!-- Quick-demo expand trigger (visible until clicked) -->
  <button x-show="!demoOpen"
          @click="demoOpen = true"
          x-transition:leave="transition ease-in duration-150"
          x-transition:leave-start="opacity-100"
          x-transition:leave-end="opacity-0"
          class="group inline-flex items-center gap-2 bg-stella-gradient text-stella-forest font-semibold rounded-xl px-6 py-3 text-sm shadow-sm mb-2">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
    Try the live demo here
    <span class="transition-transform group-hover:translate-y-0.5">↓</span>
  </button>
  <p x-show="!demoOpen" class="text-xs text-stella-muted">Tap to chat with Stella — no signup needed</p>

  <!-- Interactive live demo (revealed when demoOpen) -->
  <div x-show="demoOpen"
       x-transition:enter="transition ease-out duration-500"
       x-transition:enter-start="opacity-0 -translate-y-3"
       x-transition:enter-end="opacity-100 translate-y-0"
       style="display: none;">

    <!-- Interactive Instagram DM chat (uses real stellaDemo() Alpine state) -->
    <div class="max-w-sm mx-auto rounded-2xl border border-stella-border overflow-hidden shadow-lg bg-white text-left flex flex-col"
         style="height: 560px;"
         x-data="stellaDemo()">

      <!-- IG header -->
      <div class="shrink-0 px-4 py-2.5 flex items-center gap-2.5 border-b border-stella-border bg-white">
        <div class="w-9 h-9 rounded-full flex items-center justify-center text-white text-sm font-bold" style="background: linear-gradient(135deg, #166534, #10B981);">M</div>
        <div class="flex-1 min-w-0 leading-tight">
          <p class="text-sm font-semibold text-[#262626] truncate" x-text="chat.storeHandle"></p>
          <p class="text-[11px] text-[#8e8e8e]">Active now</p>
        </div>
        <span class="text-[10px] font-bold uppercase tracking-wider text-stella-forest bg-stella-green/20 px-2 py-0.5 rounded-full">Live</span>
      </div>

      <!-- Message thread -->
      <div class="flex-1 overflow-y-auto py-3 px-3 flex flex-col gap-2" data-chat-scroll x-ref="chatScroll">
        <div class="flex items-center gap-2 my-1">
          <div class="flex-1 h-px bg-[#efefef]"></div>
          <span class="text-[9px] uppercase tracking-wider text-[#8e8e8e] font-semibold">Today · Instagram DM</span>
          <div class="flex-1 h-px bg-[#efefef]"></div>
        </div>

        <template x-for="(msg, i) in messages" :key="i">
          <div>
            <!-- Bot bubble -->
            <template x-if="msg.role === 'bot'">
              <div class="flex flex-col items-start gap-1.5 max-w-[85%]">
                <div x-show="msg.text" class="bg-[#efefef] text-[#262626] text-sm px-3 py-2 rounded-2xl rounded-bl-md" x-text="msg.text"></div>
                <template x-if="msg.productIds && msg.productIds.length">
                  <div class="flex flex-col gap-1.5 w-full max-w-[260px]">
                    <template x-for="(pid, idx) in msg.productIds" :key="pid">
                      <div class="bg-white border border-[#dbdbdb] rounded-2xl rounded-bl-md overflow-hidden flex items-center gap-2.5 p-1.5">
                        <div class="relative shrink-0">
                          <img :src="productById(pid).image" :alt="productById(pid).name" class="w-12 h-12 rounded-lg object-cover bg-[#f5f5f5]">
                          <span class="absolute -top-1 -left-1 w-4 h-4 rounded-full bg-[#262626] text-white text-[9px] font-bold flex items-center justify-center" x-text="idx + 1"></span>
                        </div>
                        <div class="flex-1 min-w-0">
                          <p class="text-[12px] font-semibold text-[#262626] leading-tight truncate" x-text="productById(pid).name"></p>
                          <p class="text-[10px] text-[#8e8e8e] mt-0.5" x-text="formatPrice(productById(pid).price)"></p>
                          <p x-show="stock[pid] <= 0" class="text-[9px] font-semibold text-red-500 mt-0.5">Sold out</p>
                        </div>
                      </div>
                    </template>
                  </div>
                </template>
              </div>
            </template>

            <!-- Shopper bubble -->
            <template x-if="msg.role === 'user'">
              <div class="flex justify-end">
                <div class="ig-gradient-bg-m text-white text-sm px-3 py-2 rounded-2xl rounded-br-md max-w-[80%]" x-text="msg.text"></div>
              </div>
            </template>
          </div>
        </template>

        <!-- Typing indicator -->
        <div x-show="typing" class="flex items-center gap-1 bg-[#efefef] w-fit px-3 py-2.5 rounded-2xl rounded-bl-md">
          <span class="ig-dot w-1.5 h-1.5 rounded-full bg-[#8e8e8e]"></span>
          <span class="ig-dot w-1.5 h-1.5 rounded-full bg-[#8e8e8e]"></span>
          <span class="ig-dot w-1.5 h-1.5 rounded-full bg-[#8e8e8e]"></span>
        </div>
      </div>

      <!-- Suggested prompts -->
      <div class="shrink-0 px-2.5 pb-1.5 pt-2 flex gap-1.5 overflow-x-auto border-t border-[#efefef]" style="scrollbar-width:none;">
        <template x-for="prompt in suggestedPrompts" :key="prompt">
          <button @click="sendPrompt(prompt)" class="shrink-0 text-[11px] text-[#262626] border border-[#dbdbdb] rounded-full px-3 py-1 active:bg-[#f5f5f5] whitespace-nowrap" x-text="prompt"></button>
        </template>
      </div>

      <!-- IG composer -->
      <div class="shrink-0 px-2.5 py-2 flex items-center gap-2 border-t border-[#efefef] bg-white">
        <div class="flex-1 flex items-center bg-white border border-[#dbdbdb] rounded-full px-3 py-1.5">
          <input type="text"
            placeholder="Message Stella..."
            x-model="userInput"
            @keydown.enter="send()"
            class="flex-1 bg-transparent text-sm text-[#262626] placeholder:text-[#8e8e8e] focus:outline-none min-w-0">
          <button @click="send()" :disabled="!userInput" class="text-sm font-semibold text-[#0095f6] ml-2 disabled:opacity-40">Send</button>
        </div>
      </div>
    </div>

    <!-- Order ticker (driven by same demo state) -->
    <p class="mt-3 text-[11px] text-stella-muted">Stella is selling on Instagram, WhatsApp, web — same backend.</p>

  </div>
  <!-- END interactive demo -->

  <div class="mt-8">
    <a href="/schedule-demo/" class="bg-stella-gradient text-stella-forest font-semibold rounded-xl px-8 py-3.5 text-sm inline-flex items-center justify-center">
      {{ site.cta.primary }} →
    </a>
  </div>
</div>
