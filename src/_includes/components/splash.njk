<section id="splash" class="relative flex flex-col items-center justify-center min-h-screen bg-stella-bg overflow-hidden">

  <!-- Ambient blob -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] rounded-full bg-stella-green blur-[140px] opacity-[0.18]"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 text-center px-6">
    <h1 id="splash-word" class="font-drawn text-[7rem] sm:text-[9rem] lg:text-[11rem] leading-none text-stella-forest">Stella</h1>
    <p id="splash-tag" class="mt-4 text-body-lg text-stella-muted">AI that sells for you. Around the clock.</p>
  </div>

  <!-- Scroll cue -->
  <div id="splash-cue" class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2">
    <span class="block w-px h-8 bg-stella-border animate-bounce"></span>
    <p class="text-xs text-stella-muted tracking-widest uppercase">scroll</p>
  </div>

</section>
