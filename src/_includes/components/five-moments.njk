<style>
  .pin-spacer:has(#five-moments){background:#fff}
  @keyframes fm-q-bad  { 0%,42%{opacity:1;transform:translateY(0)} 52%,100%{opacity:0;transform:translateY(-8px)} }
  @keyframes fm-q-good { 0%,46%{opacity:0;transform:translateY(8px)} 58%,92%{opacity:1;transform:translateY(0)} 100%{opacity:0;transform:translateY(-8px)} }
  .fm-q-bad  { animation: fm-q-bad  4.8s ease-in-out infinite; }
  .fm-q-good { animation: fm-q-good 4.8s ease-in-out infinite; position:absolute; inset:0; }

  @keyframes fm-log { 0%{opacity:0;transform:translateX(-8px)} 12%,85%{opacity:1;transform:translateX(0)} 100%{opacity:0} }
  .fm-log-1 { animation: fm-log 6s ease-out infinite; }
  .fm-log-2 { animation: fm-log 6s ease-out 0.9s  infinite; }
  .fm-log-3 { animation: fm-log 6s ease-out 1.8s  infinite; }
  .fm-log-4 { animation: fm-log 6s ease-out 2.7s  infinite; }

  @keyframes fm-wave { 0%,100%{opacity:var(--base,.25)} 50%{opacity:1} }
  @keyframes fm-blink { 0%,100%{opacity:1} 50%{opacity:0} }
  .fm-cursor { animation: fm-blink 0.9s step-end infinite; }
</style>

<section id="five-moments" class="pt-16 pb-12 bg-white">
  <div class="pl-4 pr-6">

    <!-- Section heading -->
    <div class="text-center mb-10">
      <p class="text-xs tracking-widest uppercase text-stella-forest font-medium mb-4">{{ site.sections.fiveMoments.label }}</p>
      <h2 class="text-h2 font-light text-stella-text">{{ site.sections.fiveMoments.heading }}</h2>
      <p class="mt-3 text-lg text-stella-muted">{{ site.sections.fiveMoments.subtitle }}</p>
    </div>

    <!-- 4 cards in a row -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

      <!-- Card 1 · Discovery · mint green -->
      <div class="fm-card-row relative flex flex-col rounded-2xl overflow-hidden bg-[#86EFAC] h-[430px]">
        <!-- Tags -->
        <div class="flex gap-2 p-5 pb-0 flex-wrap">
          {% for tag in moments[0].cardTags %}
          <span class="text-[10px] font-semibold bg-black/10 text-black rounded-full px-3 py-1">{{ tag }}</span>
          {% endfor %}
        </div>
        <!-- Title + desc -->
        <div class="px-5 pt-4">
          <h3 class="text-2xl font-bold text-black leading-tight">{{ moments[0].cardLine1 }}<br>{{ moments[0].cardLine2 }}</h3>
          <p class="mt-2 text-sm text-black/60 leading-snug">{{ moments[0].cardDesc }}</p>
        </div>
        <!-- Visual: search query animation -->
        <div class="flex-1 flex flex-col justify-end p-5 gap-2 overflow-hidden">
          <div class="relative h-[36px]">
            <div class="fm-q-bad flex items-center gap-2 absolute inset-0">
              <span class="font-mono text-[11px] text-black/50 bg-white/50 rounded-lg px-2.5 py-1.5 flex-1 truncate line-through">"womens runnng shoe"</span>
              <span class="text-[11px] font-semibold text-red-500 bg-white/50 rounded-lg px-2 py-1.5 shrink-0">0</span>
            </div>
            <div class="fm-q-good flex items-center gap-2 absolute inset-0">
              <span class="font-mono text-[11px] text-black bg-white/60 rounded-lg px-2.5 py-1.5 flex-1 truncate">"morning running shoes"</span>
              <span class="text-[11px] font-semibold text-black bg-white/60 rounded-lg px-2 py-1.5 shrink-0">12</span>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <div class="flex-1 h-px bg-black/15"></div>
            <span class="text-[9px] font-mono text-black/40">understands intent</span>
            <div class="flex-1 h-px bg-black/15"></div>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-mono text-[11px] text-black bg-white/60 rounded-lg px-2.5 py-1.5 flex-1 truncate">"gift for my sister"</span>
            <span class="text-[11px] font-semibold text-black bg-white/60 rounded-lg px-2 py-1.5 shrink-0">5</span>
          </div>
        </div>
      </div>

      <!-- Card 2 · Checkout · forest dark -->
      <div class="fm-card-row relative flex flex-col rounded-2xl overflow-hidden bg-[#166534] h-[430px]">
        <!-- Tags -->
        <div class="flex gap-2 p-5 pb-0 flex-wrap">
          {% for tag in moments[2].cardTags %}
          <span class="text-[10px] font-semibold bg-white/15 text-white rounded-full px-3 py-1">{{ tag }}</span>
          {% endfor %}
        </div>
        <!-- Title + desc -->
        <div class="px-5 pt-4">
          <h3 class="text-2xl font-bold text-white leading-tight">{{ moments[2].cardLine1 }}<br>{{ moments[2].cardLine2 }}</h3>
          <p class="mt-2 text-sm text-white/60 leading-snug">{{ moments[2].cardDesc }}</p>
        </div>
        <!-- Visual: checkout log in mini terminal -->
        <div class="flex-1 flex flex-col justify-end p-5 overflow-hidden">
          <div class="bg-black/30 rounded-xl p-3 font-mono flex flex-col gap-2">
            <div class="fm-log-1 flex items-center gap-2">
              <span class="text-white/30 text-[11px] shrink-0">12:34</span>
              <span class="text-[#86efac] text-[11px] flex-1">Added Nike Air Max × 1</span>
              <span class="text-[#22c55e] text-[11px]">✓</span>
            </div>
            <div class="fm-log-2 flex items-center gap-2">
              <span class="text-white/30 text-[11px] shrink-0">12:34</span>
              <span class="text-[#86efac] text-[11px] flex-1 font-semibold">Applied WELCOME10</span>
              <span class="text-[#22c55e] text-[11px]">✓</span>
            </div>
            <div class="fm-log-3 flex items-center gap-2">
              <span class="text-white/30 text-[11px] shrink-0">12:35</span>
              <span class="text-[#86efac] text-[11px] flex-1">Sent checkout link</span>
              <span class="text-[#22c55e] text-[11px]">✓</span>
            </div>
            <div class="fm-log-4 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[#10B981] animate-pulse shrink-0"></span>
              <span class="text-white/40 text-[11px]">customer approved</span>
              <span class="fm-cursor text-[#86efac] text-[11px] ml-auto">▋</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 3 · Trust · lime -->
      <div class="fm-card-row relative flex flex-col rounded-2xl overflow-hidden bg-[#D4F08A] h-[430px]">
        <!-- Tags -->
        <div class="flex gap-2 p-5 pb-0 flex-wrap">
          {% for tag in moments[3].cardTags %}
          <span class="text-[10px] font-semibold bg-black/10 text-black rounded-full px-3 py-1">{{ tag }}</span>
          {% endfor %}
        </div>
        <!-- Title + desc -->
        <div class="px-5 pt-4">
          <h3 class="text-2xl font-bold text-black leading-tight">{{ moments[3].cardLine1 }}<br>{{ moments[3].cardLine2 }}</h3>
          <p class="mt-2 text-sm text-black/60 leading-snug">{{ moments[3].cardDesc }}</p>
        </div>
        <!-- Visual: audit log rows -->
        <div class="flex-1 flex flex-col justify-end p-5 gap-1.5 overflow-hidden">
          <div class="fm-log-1 flex items-center gap-2 bg-white/40 rounded-xl px-3 py-2">
            <span class="text-[9px] font-bold px-1.5 py-0.5 rounded-md shrink-0 bg-[#EEF2FF] text-[#818CF8]">search</span>
            <span class="text-[11px] text-black flex-1 truncate">"running shoes" → 12 results</span>
            <span class="text-[10px] text-black/40 shrink-0">2:31pm</span>
          </div>
          <div class="fm-log-2 flex items-center gap-2 bg-white/40 rounded-xl px-3 py-2">
            <span class="text-[9px] font-bold px-1.5 py-0.5 rounded-md shrink-0 bg-[#ECFDF5] text-[#10B981]">cart</span>
            <span class="text-[11px] text-black flex-1 truncate">Nike Air Max × 1 added</span>
            <span class="text-[10px] text-black/40 shrink-0">2:32pm</span>
          </div>
          <div class="fm-log-3 flex items-center gap-2 bg-white/40 rounded-xl px-3 py-2">
            <span class="text-[9px] font-bold px-1.5 py-0.5 rounded-md shrink-0 bg-[#EFF6FF] text-[#60A5FA]">coupon</span>
            <span class="text-[11px] text-black flex-1 truncate">SAVE10 applied · −$14</span>
            <span class="text-[10px] text-black/40 shrink-0">2:33pm</span>
          </div>
          <div class="flex items-center gap-1.5 mt-1 px-1">
            <span class="w-1.5 h-1.5 rounded-full bg-[#166534] animate-pulse shrink-0"></span>
            <span class="text-[9px] font-mono text-black/50">3 actions · 0 flagged</span>
          </div>
        </div>
      </div>

      <!-- Card 4 · Scale · yellow -->
      <div class="fm-card-row relative flex flex-col rounded-2xl overflow-hidden bg-[#FEF08A] h-[430px]">
        <!-- Tags -->
        <div class="flex gap-2 p-5 pb-0 flex-wrap">
          {% for tag in moments[4].cardTags %}
          <span class="text-[10px] font-semibold bg-black/10 text-black rounded-full px-3 py-1">{{ tag }}</span>
          {% endfor %}
        </div>
        <!-- Title + desc -->
        <div class="px-5 pt-4">
          <h3 class="text-2xl font-bold text-black leading-tight">{{ moments[4].cardLine1 }}<br>{{ moments[4].cardLine2 }}</h3>
          <p class="mt-2 text-sm text-black/60 leading-snug">{{ moments[4].cardDesc }}</p>
        </div>
        <!-- Visual: activity heatmap -->
        <div class="flex-1 flex flex-col justify-end p-5 overflow-hidden">
          <p class="text-[9px] font-mono text-black/35 mb-2">activity · last 7 days</p>
          <div class="flex flex-col gap-1">
            {% set days = ["M","T","W","T","F","S","S"] %}
            {% for day in days %}
            {% set di = loop.index0 %}
            <div class="flex items-center gap-1.5">
              <span class="text-[8px] font-mono text-black/30 w-2 shrink-0">{{ day }}</span>
              <div class="flex gap-0.5 flex-1">
                {% for h in range(0, 18) %}
                {% set ci = loop.index0 %}
                <div class="flex-1 h-2 rounded-sm"
                  style="background:{% if ci < 6 %}rgba(0,0,0,0.15){% elif ci < 12 %}rgba(0,0,0,0.35){% else %}rgba(0,0,0,0.65){% endif %};
                         animation:fm-wave {{ 2.5 + (ci % 4) * 0.3 }}s ease-in-out {{ (ci * 0.04 + di * 0.02) }}s infinite;
                         --base:{% if ci < 6 %}0.2{% elif ci < 12 %}0.5{% else %}0.85{% endif %}"></div>
                {% endfor %}
              </div>
            </div>
            {% endfor %}
          </div>
          <div class="flex items-center gap-1.5 mt-2">
            <span class="w-1.5 h-1.5 rounded-full bg-black/50 animate-pulse shrink-0"></span>
            <span class="text-[9px] font-mono text-black/50">24/7 · 0 downtime</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
