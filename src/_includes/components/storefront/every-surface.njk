{# ── Section 6: Sell on every channel — "One store. Every surface."
     Heading + sub, then a single horizontal row of flat-top hexagonal
     tiles, each holding a full-color brand logo. No labels, no source
     card, no pill connector. #}

{% set s = storefront.everySurface %}

{% macro surfaceIcon(id) %}
  {% if id == "web" %}
    {# Globe — on-brand emerald (Website isn't a brand) #}
    <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="16" cy="16" r="13" fill="#10B981"/>
      <ellipse cx="16" cy="16" rx="6" ry="13" fill="none" stroke="#ffffff" stroke-width="1.5"/>
      <line x1="16" y1="3" x2="16" y2="29" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round"/>
      <line x1="3" y1="16" x2="29" y2="16" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  {% elif id == "wa" %}
    {# WhatsApp — official green #25D366 #}
    <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path fill="#25D366" d="M16 3a13 13 0 00-11.2 19.6L3 29l6.6-1.7A13 13 0 1016 3z"/>
      <path fill="#ffffff" d="M22.7 19.3c-.3-.2-2-1-2.3-1.1-.3-.1-.5-.2-.7.2-.2.3-.8 1.1-1 1.3-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-2-1.8-2.3-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1.1 1.1-1.1 2.6 0 1.5 1.1 3 1.3 3.2.2.2 2.2 3.4 5.3 4.8.7.3 1.3.5 1.8.6.7.2 1.4.2 2 .1.6-.1 2-.8 2.2-1.6.3-.8.3-1.5.2-1.6-.1-.1-.3-.2-.6-.4z"/>
    </svg>
  {% elif id == "msgr" %}
    {# Messenger — blue→purple gradient #}
    <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs>
        <linearGradient id="msgr-grad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#00B2FF"/>
          <stop offset="55%" stop-color="#006AFF"/>
          <stop offset="100%" stop-color="#A33CFF"/>
        </linearGradient>
      </defs>
      <path fill="url(#msgr-grad)" d="M16 3C8.3 3 2.5 8.7 2.5 15.9c0 3.8 1.7 7.1 4.4 9.4v4.7l4-2.2c1.6.5 3.3.7 5.1.7 7.7 0 13.5-5.7 13.5-12.6S23.7 3 16 3z"/>
      <path fill="#ffffff" d="M8.4 18.4l4-6.3 3.7 3 4.2-3 4 6.3-4-3-3.8 3-3.6-3z"/>
    </svg>
  {% elif id == "ig" %}
    {# Instagram — gradient camera #}
    <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs>
        <linearGradient id="ig-grad" x1="0" y1="1" x2="1" y2="0">
          <stop offset="0%" stop-color="#FEDA75"/>
          <stop offset="25%" stop-color="#FA7E1E"/>
          <stop offset="55%" stop-color="#D62976"/>
          <stop offset="80%" stop-color="#962FBF"/>
          <stop offset="100%" stop-color="#4F5BD5"/>
        </linearGradient>
      </defs>
      <rect x="3" y="3" width="26" height="26" rx="7" fill="url(#ig-grad)"/>
      <circle cx="16" cy="16" r="6.2" fill="none" stroke="#ffffff" stroke-width="2.2"/>
      <circle cx="22.6" cy="9.4" r="1.6" fill="#ffffff"/>
    </svg>
  {% elif id == "viber" %}
    {# Viber — purple #7360F2 #}
    <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path fill="#7360F2" d="M16.7 2C9.5 1.9 4 6.7 3.5 13.4c-.4 6.7 3.5 12.4 9.8 13.3l-.4 4.3 4.1-3a14 14 0 003.8.4c6.2 0 11.2-4.8 11.2-11.7C32 9.7 26.6 2.9 16.7 2z"/>
      <path fill="#ffffff" d="M22.4 19.5c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-2-1.8-2.3-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.8-2.1c-.2-.5-.4-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.3 5.1 4.6 1.8.7 2.5.8 3.4.7.5-.1 1.9-.8 2.1-1.5.3-.8.3-1.4.2-1.5z"/>
    </svg>
  {% elif id == "agent" %}
    {# AI agents — sparkle cluster in stella-emerald #}
    <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs>
        <linearGradient id="agent-grad" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#34D399"/>
          <stop offset="100%" stop-color="#10B981"/>
        </linearGradient>
      </defs>
      <path fill="url(#agent-grad)" d="M18 3l1.8 6.2L26 11l-6.2 1.8L18 19l-1.8-6.2L10 11l6.2-1.8z"/>
      <path fill="url(#agent-grad)" d="M9.5 18l1 3.5 3.5 1-3.5 1-1 3.5-1-3.5-3.5-1 3.5-1z"/>
      <path fill="url(#agent-grad)" d="M24.5 21l.7 2.3 2.3.7-2.3.7-.7 2.3-.7-2.3-2.3-.7 2.3-.7z"/>
    </svg>
  {% endif %}
{% endmacro %}

<section id="sf-every-surface" class="relative px-4 sm:px-6 md:px-16 lg:px-28 section-reveal pt-12 md:pt-20 pb-20 md:pb-28 bg-white overflow-hidden">

  {# ── Heading #}
  <div class="relative z-10 max-w-3xl mx-auto text-center">
    <p data-reveal="eyebrow" class="text-xs font-semibold tracking-[0.18em] uppercase text-stella-muted mb-4">
      {{ s.eyebrow }}
    </p>
    <h2 data-reveal="headline" class="text-[28px] sm:text-4xl lg:text-5xl font-light text-black tracking-[-0.015em] leading-[1.15]">
      {{ s.heading }}
    </h2>
    <p data-reveal="subhead" class="mt-4 sm:mt-5 text-base sm:text-body-lg text-stella-muted leading-relaxed">
      {{ s.sub }}
    </p>
  </div>

  {# ── Single row of flat-top hexagonal logo tiles (rounded corners, hover stroke) #}
  {% set hexPath = "M 21,6.928 Q 25,0 33,0 L 67,0 Q 75,0 79,6.928 L 96,36.372 Q 100,43.3 96,50.228 L 79,79.672 Q 75,86.6 67,86.6 L 33,86.6 Q 25,86.6 21,79.672 L 4,50.228 Q 0,43.3 4,36.372 Z" %}
  <div class="relative z-10 mt-14 md:mt-16 flex justify-center items-center gap-4 sm:gap-6 md:gap-8 flex-wrap">
    {% for surf in s.surfaces %}
      <div class="group relative w-20 h-[69px] sm:w-24 sm:h-[83px] md:w-28 md:h-[97px] transition-transform duration-200 hover:-translate-y-1"
           style="filter: drop-shadow(0 10px 18px rgba(15, 23, 42, 0.10)) drop-shadow(0 2px 4px rgba(15, 23, 42, 0.06));">
        <svg viewBox="0 0 100 86.6" preserveAspectRatio="xMidYMid meet" class="absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="{{ hexPath }}" fill="#ffffff"/>
          <path d="{{ hexPath }}" fill="none" stroke="#10B981" stroke-width="2.5" class="opacity-0 transition-opacity duration-300 group-hover:opacity-100"/>
        </svg>
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="w-8 sm:w-10 md:w-11">
            {{ surfaceIcon(surf.id) }}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  {# ── Footnote #}
  <p class="relative z-10 mt-12 md:mt-14 max-w-2xl mx-auto text-center text-sm text-stella-muted leading-relaxed">
    {{ s.footnote }}
  </p>

</section>
