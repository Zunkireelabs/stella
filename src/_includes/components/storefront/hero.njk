<section id="sf-hero" class="relative pt-32 md:pt-40 pb-20 md:pb-28 px-4 sm:px-6 md:px-16 lg:px-28 overflow-hidden bg-white">

  <!-- Subtle bg wash — radial gradient sitting behind the hero title, fades softly to transparent -->
  <div class="absolute inset-0 pointer-events-none"
       style="background: radial-gradient(ellipse 55% 45% at 50% 35%, rgba(134, 239, 172, 0.35), rgba(134, 239, 172, 0) 70%);">
  </div>

  <div class="relative z-10 max-w-4xl mx-auto text-center">

    <h1 id="sf-hero-headline" class="text-3xl sm:text-5xl lg:text-6xl font-light text-black tracking-[-0.015em] leading-[1.12]">
      {{ storefront.hero.headline | safe }}
    </h1>

    <p id="sf-hero-sub" class="mt-4 sm:mt-5 text-base sm:text-body-lg text-stella-muted max-w-2xl mx-auto leading-relaxed">
      {{ storefront.hero.sub }}
    </p>

    <div id="sf-hero-ctas" class="mt-8 flex justify-center">
      <a id="hero-btn-demo" href="{{ storefront.hero.primaryCta.href }}"
         class="relative overflow-hidden bg-stella-gradient text-stella-forest font-semibold rounded-xl px-8 py-3.5 text-sm shadow-sm inline-flex items-center justify-center">
        <span class="btn-glow-layer absolute inset-0 rounded-xl pointer-events-none opacity-0"
              style="--mouse-x:50%;--mouse-y:50%;background: radial-gradient(circle 120px at var(--mouse-x) var(--mouse-y), rgba(255,255,255,0.65), transparent);"></span>
        <span class="relative z-10">{{ storefront.hero.primaryCta.label }} →</span>
      </a>
    </div>

  </div>
</section>
