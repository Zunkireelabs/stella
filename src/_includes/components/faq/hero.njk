<section id="faq-hero" class="relative pt-32 md:pt-40 pb-12 md:pb-16 px-4 sm:px-6 md:px-16 lg:px-28 overflow-hidden">

  <div class="absolute inset-0 pointer-events-none -z-0">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_rgba(212,240,138,0.55)_0%,_rgba(212,240,138,0.28)_45%,_rgba(247,255,228,0)_85%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-stella-bg"></div>
  </div>

  <div class="relative z-10 max-w-3xl mx-auto text-center">

    <p class="text-xs font-semibold tracking-[0.18em] uppercase text-stella-muted mb-4">
      {{ faq.hero.eyebrow }}
    </p>

    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-black tracking-[-0.015em] leading-[1.12]">
      {{ faq.hero.heading }}
    </h1>

    <p class="mt-4 sm:mt-5 text-base sm:text-body-lg text-stella-muted max-w-2xl mx-auto leading-relaxed">
      {{ faq.hero.sub }}
    </p>

  </div>
</section>
