{% set c = faq.cta %}

<section class="pt-4 pb-16 md:pb-20">
  <div class="max-w-5xl mx-auto px-6">
    <div class="bg-stella-lime rounded-3xl px-6 sm:px-10 md:px-16 py-12 sm:py-14 md:py-16 text-center">

      <h2 class="text-3xl sm:text-4xl md:text-h2 font-light text-stella-forest mb-4 tracking-[-0.015em] leading-[1.15]">
        {{ c.heading }}
      </h2>

      <p class="text-base sm:text-lg text-stella-forest/80 mb-8 sm:mb-10 max-w-2xl mx-auto leading-relaxed">
        {{ c.sub }}
      </p>

      <div class="flex justify-center">
        <a href="{{ c.primaryCta.href }}"
           class="bg-white text-stella-forest font-semibold rounded-xl px-8 py-3 hover:shadow-md transition-shadow">
          {{ c.primaryCta.label }} →
        </a>
      </div>

    </div>
  </div>
</section>
