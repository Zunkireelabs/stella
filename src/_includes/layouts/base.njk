<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {% if env == 'development' %}
  <meta name="robots" content="noindex, nofollow">
  {% endif %}
  <title>{{ title | default(site.name) }}</title>
  <meta name="description" content="{{ description | default(site.description) }}">
  <!-- Inter Variable — preconnect for faster load -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Caveat:wght@700&family=Pacifico&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/tailwind.css">
  <script type="importmap">{"imports":{"three":"/assets/vendor/three.module.js"}}</script>
</head>
<body x-data class="bg-stella-bg text-stella-text font-sans antialiased">

  <!-- Mobile nav backdrop — body level, z-40 -->
  <div
    x-data="{ open: false }"
    @navmobile.window="open = $event.detail"
    @click="open = false; window.dispatchEvent(new CustomEvent('navclose'))"
    x-show="open"
    x-cloak
    x-transition:enter="transition duration-200 ease-out"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition duration-150 ease-in"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 top-20 bg-black/50 z-40 md:hidden"
    aria-hidden="true"
  ></div>

  <!-- Mobile drawer — body level so no stacking context from nav/main can trap it -->
  <div
    x-data="{ open: false }"
    @navmobile.window="open = $event.detail"
    @navclose.window="open = false"
    x-show="open"
    x-cloak
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-2"
    class="md:hidden fixed inset-x-0 top-20 border-t border-stella-border overflow-y-auto px-6 py-3 flex flex-col shadow-xl"
    style="background:#ffffff;z-index:9990"
  >

    {# Product accordion #}
    <div x-data="{ open: false }" class="border-b border-stella-border">
      <button
        @click="open = !open"
        class="w-full flex items-center justify-between py-4 text-left"
      >
        <span class="text-sm font-medium text-stella-text">Product</span>
        <svg class="w-4 h-4 text-stella-muted transition-transform" :class="{ 'rotate-180': open }" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>
      <div x-show="open" x-cloak class="pb-3">
        <a href="/storefront/" class="flex flex-col py-2.5 pl-2">
          <span class="text-sm text-stella-text font-medium">{{ storefront.navMenu.label }}</span>
          <span class="text-xs text-stella-muted mt-0.5">{{ storefront.navMenu.description }}</span>
        </a>
      </div>
    </div>

    {# Resources accordion #}
    <div x-data="{ open: false }" class="border-b border-stella-border">
      <button
        @click="open = !open"
        class="w-full flex items-center justify-between py-4 text-left"
      >
        <span class="text-sm font-medium text-stella-text">Resources</span>
        <svg class="w-4 h-4 text-stella-muted transition-transform" :class="{ 'rotate-180': open }" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>
      <div x-show="open" x-cloak class="pb-3">
        {% for item in resources.navMenu.items %}
        <a href="{{ item.href }}" class="flex flex-col py-2.5 pl-2">
          <span class="text-sm text-stella-text font-medium">{{ item.label }}</span>
          <span class="text-xs text-stella-muted mt-0.5">{{ item.description }}</span>
        </a>
        {% endfor %}
      </div>
    </div>

    {# Customer Stories #}
    <a href="/customer-stories/" class="py-4 text-sm font-medium text-stella-text border-b border-stella-border">Customer Stories</a>

    <div class="mt-4 pt-2 flex flex-col gap-3">
      <a href="https://app.stella-commerce.com/login" class="text-sm text-stella-muted text-center">Sign In</a>
      <a href="/schedule-demo/" class="bg-stella-gradient text-stella-forest font-semibold text-sm rounded-xl px-5 py-3 text-center hover:opacity-90 transition-opacity">
        {{ site.cta.primary }} →
      </a>
    </div>
  </div>

  {% if page.url == '/' %}
  <!-- Page loader (landing page only) -->
  <div id="page-loader" class="fixed inset-0 z-[9997]" style="background:#f7ffe4"></div>
  <div id="loader-logo-wrap" class="fixed z-[9999]" style="visibility:hidden">
    <span id="loader-text" class="font-pacifico" style="line-height:1;white-space:nowrap;color:#0F1216"></span>
  </div>
  <div id="loader-dot" class="fixed rounded-full z-[9999]" style="width:52px;height:52px;background:#e0e503;visibility:hidden"></div>
  <noscript><style>#page-loader,#loader-logo-wrap,#loader-dot{display:none!important}</style></noscript>
  {% endif %}

  <main>
    {{ content | safe }}
  </main>

  <script src="/assets/vendor/lenis.min.js"></script>
  <script src="/assets/vendor/gsap.min.js"></script>
  <script src="/assets/vendor/ScrollTrigger.min.js"></script>
  <script src="/assets/vendor/SplitText.min.js"></script>
  <script defer src="/assets/vendor/alpine.min.js"></script>
  <script src="/assets/js/main.js"></script>
  <script type="module" src="/assets/js/hero-scene.js"></script>
</body>
</html>
