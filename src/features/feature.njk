---
pagination:
  data: moments
  size: 1
  alias: moment
permalink: /features/{{ moment.slug }}/
layout: layouts/base.njk
---

<main class="max-w-3xl mx-auto px-6 py-24">

  <a href="/" class="inline-flex items-center gap-2 text-sm text-stella-muted hover:text-stella-text transition-colors mb-12">
    ← Back to Stella
  </a>

  <div class="mb-10">
    <span class="text-xs font-semibold text-stella-forest uppercase tracking-widest">{{ moment.eyebrow if moment.eyebrow else "Feature" }}</span>
    <h1 class="mt-3 text-4xl font-bold text-stella-text tracking-tight leading-tight">{{ moment.pageTitle }}</h1>
    <p class="mt-4 text-lg text-stella-muted leading-relaxed max-w-xl">{{ moment.pageDesc }}</p>
  </div>

  <div class="h-px bg-stella-border mb-10"></div>

  {% if moment.sections %}
  <div class="space-y-10">
    {% for section in moment.sections %}
    <div>
      <h2 class="text-xl font-bold text-stella-text mb-3">{{ section.heading }}</h2>
      <p class="text-stella-muted leading-relaxed">{{ section.body }}</p>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <div class="mt-16 pt-10 border-t border-stella-border">
    <p class="text-sm text-stella-muted mb-4">Ready to see it live on your store?</p>
    <a href="/#demo" class="inline-flex items-center gap-2 bg-stella-text text-white font-semibold text-sm px-6 py-3 rounded-xl hover:opacity-90 transition-opacity">
      Schedule a demo →
    </a>
  </div>

</main>
