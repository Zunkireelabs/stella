{
  "name": "stella-web-dev",
  "version": "1.0.0",
  "description": "Stella Commerce — product landing page",
  "scripts": {
    "dev": "concurrently \"npx @11ty/eleventy --serve\" \"npx tailwindcss -i ./src/assets/css/main.css -o ./src/assets/css/tailwind.css --watch\"",
    "build": "npx tailwindcss -i ./src/assets/css/main.css -o ./src/assets/css/tailwind.css --minify && npx @11ty/eleventy"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4"
  },
  "dependencies": {
    "alpinejs": "^3.14.1",
    "gsap": "^3.12.5"
  }
}
